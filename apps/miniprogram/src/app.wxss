page {
  background: #f7f7f8;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  color: #1a1a1a;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 24rpx;
}

.btn-primary {
  background: #4f46e5;
  color: #fff;
  border-radius: 999rpx;
  padding: 28rpx 0;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-primary[disabled] {
  opacity: 0.5;
}

.muted { color: #8a8a8e; font-size: 26rpx; }
