/* ⭐ UnoCSS 生成的原子类。由 build.mjs 产出到 dist/uno.wxss（构建期扫源码生成，零运行时） */
@import "./uno.wxss";
/* ⭐ 图标（Iconify → 每个图标一条 CSS mask，data URI 内联）—— 由 tools/iconfont/build.mjs 生成，勿手改 */
@import "./icons.wxss";

/**
 * 这里**只保留全局基线**。
 * 所有组件级样式（卡片、按钮、文字层级）一律用 UnoCSS 工具类写在 WXML 上 ——
 * 见 docs/research/styling-decision.md。
 *
 * ⚠️ 为什么不在这里留 .card / .btn-primary 之类的语义类：
 *    页面 WXSS 在 app.wxss 之后加载，两个页面对同名类写不同定义时会互相"意外生效"
 *    （迁移前 selftest 页就重新定义了 .card 和 .btn-primary，和首页长得完全不一样）。
 *    工具类写在元素上，没有这种跨页覆盖问题。
 *
 * ⚠️ 下面两个色值是 uno.config.mjs 里 theme.colors.page.DEFAULT / page.on 的**镜像** ——
 *    手写 CSS 引用不到 UnoCSS 的 token，只能写字面量。改主题色时这里要一起改。
 * ⚠️⚠️ 它是**元素选择器、且在本文件 @import uno.wxss 之后**，所以本条**优先级高于** 页面根节点上
 *    写的「bg-page」类。两处不一致时，页面看到的底色是**这里**这个值 —— 改色必须同时改两处。
 */
page {
  background: #ffffff; /* theme.colors.page.DEFAULT */
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  color: #131311; /* theme.colors.page.on */
}
