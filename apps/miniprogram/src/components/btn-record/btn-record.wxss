/*
 * ⭐ 参与区（五态）—— 尺寸逐条照抄 Figma 539:871（1px = 2rpx）。见 btn-record.wxml 的说明。
 * ⚠️ 只写：currentColor、--btn-bg / --btn-fg（宿主声明）、以及稿子里的尺寸。
 */
.br-fill,
.br-line {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;          /* 稿 48 */
  border-radius: 72rpx;   /* 稿 r36 = 48 高的一半 ⇒ 全圆 */
  box-sizing: border-box;
}

/* ① try：实心 */
.br-fill {
  gap: 16rpx;             /* 稿 gap8 */
  padding: 0 24rpx;       /* 稿 pad12 */
  background: var(--btn-bg, currentColor);
  color: var(--btn-fg, #ffffff);
}

/*
 * ③④⑤ 描边胶囊 —— 三组**贴两边均匀分布**，且**左右各内缩 8**。
 * ⚠️ 两个数缺一不可（都来自稿子的两处，别只看外层那个）：
 *    · 外层 「button」：「main=SPACE_BETWEEN」、pad 左右 **0**；
 *    · 内层 「Frame 13」 / 「Frame 15」（那两颗圆所在的组）：宽 58、**pad 左右各 8** ⇒
 *      32 的圆从 **8** 处开始 ⇒ 视觉上圆是**内缩**的，不会顶到胶囊的圆角上被切掉。
 * ⚠️ 所以这里写 「padding: 0 16rpx」（= 外层 0 + 内层 8）——
 *    只写 「space-between」 会让两颗圆贴边被圆角切一半。
 */
.br-line {
  justify-content: space-between;
  gap: 16rpx;             /* 稿 gap8 */
  padding: 0 16rpx;       /* 稿：外层 0 + 内层各 8 */
  border: 2rpx solid currentColor;   /* 稿 stroke 1px */
}

/* ② retry：一行，两端对齐 */
.br-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
}
.br-score { display: flex; align-items: center; gap: 16rpx;   /**
   * ⚠️ **热区**：稿里这组只有 60×24（= 120×48rpx）—— 手指够不准。
   *    加竖向内边距把它撑到 88rpx 左右（**视觉不变**：柱子与数字仍然各自居中）。
   */
  padding: 20rpx 8rpx;
  box-sizing: content-box;
}

/* ⭐ 波形 = 5 根矩形（稿 Frame 26 18×24 · 2 宽 · gap2） */
.br-wave { display: flex; align-items: center; gap: 4rpx; height: 48rpx; }
.br-bar {
  width: 4rpx;            /* 稿 2 */
  border-radius: 2rpx;
  background: currentColor;
}

/*
 * 实心圆 48×48（retry 的麦克风）。
 * ⚠️ 另外那两颗（↺ / ✓）**不在这里画** —— 它们是 「ui-button」：
 *    ↺ = variant="glass"（半透明主色 + ink 图标）· ✓ = variant="fill"（实心 + 反色图标）。
 *    自己画一遍就等于把 ui-button 的圆角/禁用态/按压反馈再实现一次（会漂）。
 */
.br-c48 {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 9999rpx;
  background: var(--btn-bg, currentColor);
  color: var(--btn-fg, #ffffff);
  width: 96rpx;   /* 稿 48×48 */
  height: 96rpx;
}

/* 可点区域：⚠️ 图标本身小（14），但点击区要够 —— 用 min 尺寸兜住 */
.br-hit {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 64rpx;       /* 稿里 ↺/✓ 的圆是 32 ⇒ 点击区不小于它 */
  height: 64rpx;
}
.br-play { gap: 8rpx; padding: 0 16rpx; }   /* 稿 Frame 14：pad8 / gap4 */
.br-arrow { gap: 8rpx; padding: 0 24rpx; }  /* 稿 Frame 15：pad12 / gap4 */

/* 字号：稿 14 / 16（700 只用在分数上） */
.br-t14 { font-size: 28rpx; line-height: 1; }
.br-t16 { font-size: 32rpx; font-weight: 700; line-height: 1; }
.br-bold { font-weight: 700; }

/* 图标尺寸 = 稿里的 px × 2 */
/*
 * ⭐⭐ **图标尺寸一律写 font-size，不写 width/height**（用户 2026-10-15 报的"图标不居中"就是这条）。
 *
 * ⚠️⚠️ 为什么：「ui-icon」 里面那个盒子是 **1em**（跟着**字号**走，见 icons.wxss 的 .ui-icon），
 *    而组件的**宿主节点**才是 flex 项。在宿主上写 width/height 只会把宿主撑成那么大 ——
 *    里面真正的图标仍是"继承来的字号"那么大，还按 「vertical-align: -0.125em」 坐在基线上
 *    ⇒ 看起来**偏上、不居中**（尺寸也不是你以为的那个数）。
 *    ⇒ 宿主给 「font-size」 + 「line-height: 1」：1em 就等于这个字号，宿主盒子正好裹住它，
 *      外层 flex 的居中才是真居中。
 */
.br-i12 { font-size: 24rpx; line-height: 1; display: flex; }
.br-i14 { font-size: 28rpx; line-height: 1; display: flex; }
.br-i20 { font-size: 40rpx; line-height: 1; display: flex; }
.br-i24 { font-size: 48rpx; line-height: 1; display: flex; }
.br-on { color: var(--btn-fg, #ffffff); }

.br-spin { animation: br-spin 0.9s linear infinite; }
@keyframes br-spin { to { transform: rotate(360deg); } }
