/**
 * ⚠️ 这两个组件里的样式**刻意全部写成普通类名，不用 UnoCSS 工具类** ——
 *    和页面里的写法不一样，是有意的：
 *
 *    ① 这些类几乎全是「固定浮层 + 精确像素定位 + 过渡动画」，
 *       用工具类写要靠 fixed/inset/z-/translate/transition 一串变体，
 *       其中任何一个在 weapp 预设下没生成，表现都是**静默失效**（见 uno.config.mjs）。
 *    ② 不依赖 app.wxss：组件样式默认就是 isolated 的，
 *       自带一份完整定义最稳 —— 导航栏是每一页的头顶，它不能有「有时没样式」的可能。
 *
 *    页面里的样式照旧用工具类，这两者不冲突。
 */
/* ⚠️ 本组件是 isolated（见上），app.wxss 里的 .iconfont 进不来，必须自己引一份 */
@import "../../iconfont.wxss";

.nv-root {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  /* ⚠️ 默认**透明**：页面底色（#f7f7f8）本身就是设计的一部分，
     还没滚动时就压一条白带，会凭空多出一条没人要的分界线。
     ⚠️ 用 rgba(255,255,255,0) 而不是 transparent：后者是 rgba(0,0,0,0)，
     过渡到白色时中间会灰一下。
     ⚠️ content-box：height 只算内容区，状态栏那一段靠 padding-top 撑出来 */
  box-sizing: content-box;
  background-color: rgba(255, 255, 255, 0);
  /* ⚠️ 边框**一直占位**、只改颜色：白底出现时若边框才加上，
     整页会往下跳 1px。 */
  border-bottom: 1rpx solid rgba(255, 255, 255, 0);
  transition: background-color 0.18s ease-out, border-bottom-color 0.18s ease-out;
}

/**
 * ⭐ 页面内容与导航栏**相交之后**才落白底。
 *    「相交」的判定在页面那边（scrollTop >= navSolidFrom()），见 methods.applyScrollTop。
 */
.nv-root-solid {
  background-color: #ffffff;
  border-bottom-color: #f0f0f0;
}

.nv-row {
  display: flex;
  align-items: center;
  height: 100%;
}

/* ⚠️ 左右两侧**等宽**，标题居中才是真的居中 */
.nv-side {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  padding-left: 24rpx;
  box-sizing: border-box;
}

.nv-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #111;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 头像：真头像 or 本地那张占位图（见 nav-bar.ts 的 avatarPlaceholder） */
.nv-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #eeecfd;
  overflow: hidden;
}

/**
 * ⭐ 身份解析中（启动登录还没回来）时的转圈 —— 占住左侧那一格。
 * ⚠️ 尺寸与头像同高（60rpx），否则标题左侧的内容会跳一下。
 * ⚠️ sideWidth 是固定宽度，所以它不会把标题挤偏。
 */
.nv-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid #e5e5ea;
  border-top-color: #4f46e5;
  border-radius: 50%;
  animation: nv-spin 0.7s linear infinite;
}

@keyframes nv-spin {
  to {
    transform: rotate(360deg);
  }
}

/* 未登录时那一格画的是按钮而不是头像：说清楚"点这里能登录"，
   比画一个空圆圈再让人猜要好 */
.nv-login {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #4f46e5;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 500;
}

/* ⚠️ 换成图标字体后字号要重新定：MDI 是 24 网格，字形自带留白，
   home 只占约 83%、chevron 只占 50% —— 值按视觉高度反推，不是随手加的 */
.nv-glyph {
  font-size: 38rpx;
  line-height: 1;
  color: #333;
}

.nv-glyph-back {
  font-size: 42rpx;
  color: #666;
}

.nv-hover {
  opacity: 0.55;
}
