/**
 * ⚠️ 和 nav-bar.wxss 一样：这里全部用普通类名，不用 UnoCSS 工具类 —— 原因见那个文件的说明。
 *    这一屏几乎全是「遮罩 + 从底部推上来」的定位与过渡，工具类在这里最容易静默失效。
 */

/* 整屏的一层：遮罩 + 面板都挂在它下面 */
.us-layer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 200;
}

/* ⚠️ 不能用 inset: 0 简写 —— 老 WebView 不认，整条声明会被丢掉 */
.us-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.45);
  opacity: 0;
  transition: opacity 0.2s ease-out;
}

.us-mask-on {
  opacity: 1;
}

.us-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  /* ⚠️ 必须在遮罩之上：两者是兄弟，靠 z-index 分前后 */
  z-index: 1;
  /* 半屏 —— 用户明确要的「从底部向上滑动半屏」 */
  height: 50vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 0 32rpx;
  /* 全面屏底部那条横条，别让最后一行压在它上面 */
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  transform: translateY(100%);
  transition: transform 0.22s ease-out;
}

.us-panel-on {
  transform: translateY(0);
}

.us-grab {
  width: 72rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: #e5e5e5;
  margin: 16rpx auto 0;
  padding: 12rpx 0;
  background-clip: content-box;
}

.us-head {
  display: flex;
  align-items: center;
  padding: 20rpx 0 28rpx;
}

.us-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #eeecfd;
  flex-shrink: 0;
}

.us-avatar-text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 600;
  color: #4f46e5;
}

.us-idcol {
  flex: 1;
  margin-left: 24rpx;
  overflow: hidden;
}

.us-name {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #111;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.us-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.us-stats {
  display: flex;
  padding: 24rpx 0;
  border-top: 1rpx solid #f0f0f0;
  border-bottom: 1rpx solid #f0f0f0;
}

.us-stat {
  flex: 1;
  text-align: center;
}

.us-stat-v {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #111;
  line-height: 1.2;
}

.us-stat-k {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999;
}

.us-sec {
  display: flex;
  align-items: baseline;
  padding: 24rpx 0 12rpx;
}

.us-sec-t {
  font-size: 28rpx;
  font-weight: 600;
  color: #111;
}

.us-sec-n {
  margin-left: auto;
  font-size: 22rpx;
  color: #999;
}

/* ⚠️ scroll-view 必须有**确定的高度**才能滚：flex:1 在这里就是那个高度，
   而它外面的 .us-panel 是固定 50vh —— 所以内容是溢出去滚，不是把面板撑高 */
.us-scroll {
  flex: 1;
  overflow: hidden;
}

.us-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
}

.us-item-off {
  opacity: 0.35;
}

.us-item-emoji {
  width: 56rpx;
  font-size: 32rpx;
  flex-shrink: 0;
}

.us-item-col {
  flex: 1;
  overflow: hidden;
}

.us-item-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #111;
}

.us-item-note {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #999;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.us-item-days {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #666;
}

.us-foot {
  padding: 24rpx 0 40rpx;
  border-top: 1rpx solid #f0f0f0;
}

.us-foot-t {
  display: block;
  font-size: 24rpx;
  color: #333;
}

.us-foot-n {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999;
}
