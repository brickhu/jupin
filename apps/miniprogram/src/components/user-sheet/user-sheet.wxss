/**
 * ⚠️ 和 nav-bar.wxss 一样：这里全部用普通类名，不用 UnoCSS 工具类 —— 原因见那个文件的说明。
 *    这一屏几乎全是「遮罩 + 从底部推上来」的定位与过渡，工具类在这里最容易静默失效。
 */

/* 整屏的一层：遮罩 + 面板都挂在它下面 */
.us-layer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 200;
}

/* ⚠️ 不能用 inset: 0 简写 —— 老 WebView 不认，整条声明会被丢掉 */
.us-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.45);
  opacity: 0;
  transition: opacity 0.2s ease-out;
}

.us-mask-on {
  opacity: 1;
}

.us-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  /* ⚠️ 必须在遮罩之上：两者是兄弟，靠 z-index 分前后 */
  z-index: 1;
  /* ⚠️ 高度**跟着内容走**（auto + max-height），不再写死半屏：
     原来那一整张等级徽章阶梯去掉之后，面板里只剩「头像 + 四个数字 + 三行菜单」，
     写死 50vh 会在底部留一大块什么都没有的白 —— 看起来像内容没加载出来。
     max-height 是护栏：菜单以后变长也不会把自己顶出屏幕。 */
  max-height: 70vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 0 32rpx;
  /* 全面屏底部那条横条，别让最后一行压在它上面 */
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  transform: translateY(100%);
  transition: transform 0.22s ease-out;
}

.us-panel-on {
  transform: translateY(0);
}

.us-grab {
  width: 72rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: #e5e5e5;
  margin: 16rpx auto 0;
  padding: 12rpx 0;
  background-clip: content-box;
}

.us-head {
  display: flex;
  align-items: center;
  padding: 20rpx 0 28rpx;
}

/* 整块可点 —— 加个按下反馈，不然"修改"两个字看起来像装饰 */
.us-head-hover {
  opacity: 0.6;
}

/* 改头像 / 改昵称的入口。放在最右边，不抢昵称的位置 */
.us-edit {
  margin-left: auto;
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #f3f2ff;
  color: #4f46e5;
  font-size: 22rpx;
}

.us-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #eeecfd;
  flex-shrink: 0;
}

.us-idcol {
  flex: 1;
  margin-left: 24rpx;
  overflow: hidden;
}

.us-name {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #111;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.us-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.us-stats {
  display: flex;
  padding: 24rpx 0;
  border-top: 1rpx solid #f0f0f0;
  border-bottom: 1rpx solid #f0f0f0;
}

.us-stat {
  flex: 1;
  text-align: center;
}

.us-stat-v {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #111;
  line-height: 1.2;
}

.us-stat-k {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999;
}

/* ⭐ 菜单 —— 一行一个入口。
   ⚠️ 这里原来是一整张「等级徽章」阶梯（.us-sec / .us-scroll / .us-item* / .us-foot*），
      已按产品要求整体去掉：拉开面板是来找入口的，不是来读等级表的。 */
.us-menu {
  margin-top: 8rpx;
  border-top: 1rpx solid #f0f0f0;
}

.us-menu-item {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.us-menu-hover {
  opacity: 0.55;
}

.us-menu-icon {
  width: 48rpx;
  font-size: 30rpx;
  flex-shrink: 0;
}

.us-menu-label {
  flex: 1;
  font-size: 28rpx;
  color: #111;
}

/* 右箭头：让「这一行可以点」这件事不用猜 */
.us-menu-arrow {
  flex-shrink: 0;
  font-size: 32rpx;
  color: #c8c8cd;
}
