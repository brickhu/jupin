<!--
  ⭐ 能量扣除面板 —— 结构照 Figma 「612:2044」（1px = 2rpx）。
  纵向顺序：**文案 → 大号 ⚡-N → 两个按钮**（稿里文案在上、大字在中间）。
  ⚠️ 两个数由**页面**从服务端权威值算好传进来，组件不做减法。

  ⚠️⚠️ **外框（遮罩 / 居中 / 出入场动画 / 挡住底下的页面）由 「ui-dialog」 统一提供**（B92）——
     这里只回答"面板里有什么"，不再自带 layer / mask / 卡片与动画。
  · 「show」 恒为 「true」：在不在由宿主的 「wx:if」 决定，而 ui-dialog 挂载时会自己放出来；
  · 「closable="{{false}}"」：能量还没扣，但**点遮罩就关掉**会让用户以为白花了一次；
  · 「bare」：这个面板既没有标题、也没有脚 —— 不留那两行（留了会白占一段 gap）。
-->
<ui-dialog show="{{true}}" position="center" closable="{{false}}" bare>
  <view class="et-body">
    <!-- 正在问服务端要权威余额 —— 这几百毫秒必须看得见，否则用户以为点了没反应 -->
    <view wx:if="{{phase === 'precheck'}}" class="et-precheck">
      <ui-icon class="et-spin text-56rpx" name="mdi:loading" />
      <text class="et-t14 et-sub mt-3">正在确认能量…</text>
    </view>

    <block wx:else>
      <!-- ① 文案（稿 14px，在**大字的上面**） -->
      <text wx:if="{{balance >= cost}}" class="et-t14 et-ink">本次 AI 检测将消耗能量 {{cost}} ⚡，剩余 {{balance - cost}} ⚡</text>
      <!-- ⭐ 不够**不是错误，是业务规则**：说清差多少 + 一个能走的出口，不写成"失败" -->
      <text wx:else class="et-t14 et-ink">能量不够了 —— 本次评测需要 {{cost}} 点，现在有 {{balance}} 点</text>

      <!-- ② 大号 ⚡-N（稿 64px/400） -->
      <text class="et-big mt-[72rpx]">⚡-{{cost}}</text>

      <!-- ③ 两个按钮（稿 40 高）—— ⚠️ 取消在左（描边）、确认在右（实心） -->
      <view class="et-actions">
        <view class="flex-1">
          <ui-button variant="outline" color="primary" size="md" roundness="full" width="full" bind:press="onCancel">
            <text class="et-t14">取消</text>
          </ui-button>
        </view>
        <view class="flex-1">
          <ui-button wx:if="{{balance >= cost}}" variant="fill" color="primary" size="md" roundness="full" width="full"
                     bind:press="onConfirm">
            <text class="et-t14">确认</text>
          </ui-button>
          <ui-button wx:else variant="fill" color="primary" size="md" roundness="full" width="full" bind:press="onGoEnergy">
            <text class="et-t14">去补能量</text>
          </ui-button>
        </view>
      </view>
    </block>
  </view>
</ui-dialog>
