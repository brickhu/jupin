/**
 * 表单样式。全部留在这个组件里 —— 两个页面（加入 / 修改资料）共用同一份，
 * 样式跟着组件走，不跟着页面走，才不会一边改了一遍没改。
 *
 * ⚠️ 其余一律用 UnoCSS 工具类写在 WXML 上（见 docs/research/styling-decision.md）。
 */

.pf-card {
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
}

.pf-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 112rpx;
  padding: 0 28rpx;
}

.pf-label {
  flex-shrink: 0;
}

/* 字段之间的细线：左边缩进对齐文字，右边通到边 —— 表格式列表的常见做法 */
.pf-line {
  height: 1rpx;
  background: #f0f0f0;
  margin-left: 28rpx;
}

/**
 * 头像按钮：把 button 的默认皮肤清干净，只留一个可点的圆。
 *
 * ⚠️ margin-left: auto 是**必须的**，不能只靠容器上的 justify-between：
 *    小程序给 button 的默认样式里带 margin-left/right: auto，
 *    这里写 margin 简写时漏掉哪一边，它就会退回默认的"水平居中" ——
 *    表现是圆圈浮在行中间，而不是贴在右边。显式写死最稳。
 */
.pf-avatar {
  padding: 0;
  margin: 0 0 0 auto;
  width: 88rpx;
  height: 88rpx;
  line-height: 1;
  background: transparent;
  border: none;
  border-radius: 0;
  flex-shrink: 0;
}

.pf-avatar::after {
  border: none;
}

/* 圆本身 —— 选了头像就是那张图，没选就是一个带 ＋ 的浅紫底圆 */
.pf-avatar-img {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #eeecfd; /* = 品牌色 10% 混白，与导航栏那个头像底色一致 */
}

/* 昵称输入：占满标签右边的全部宽度，文字**靠右** —— 与上一行那个 ＋ 对齐成一列 */
.pf-input {
  flex: 1;
  margin-left: 24rpx;
  height: 88rpx;
  font-size: 30rpx;
  color: #111;
  text-align: right;
}

.pf-input-ph {
  color: #b9b9c0;
}
/* 性别 picker：占满标签右边，文字靠右 —— 与昵称那一行对齐成一列 */
.pf-picker {
  flex: 1;
  margin-left: 24rpx;
}

.pf-pick {
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  color: #111;
  text-align: right;
}

.pf-pick-ph {
  color: #b9b9c0;
}

/* 简介：唯一的多行字段，不套 .pf-row 的固定行高 */
.pf-bio {
  padding: 24rpx 28rpx 28rpx;
}

.pf-textarea {
  width: 100%;
  min-height: 120rpx;
  font-size: 30rpx;
  color: #111;
  line-height: 1.6;
}
