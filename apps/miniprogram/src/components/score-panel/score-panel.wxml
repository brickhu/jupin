<!--
  ⭐ 出分面板 —— 结构照 Figma 「588:1791」(score-update) / 「588:1814」(score-nonupdate)（1px = 2rpx）。
  纵向：**波形+时长 ····· 分数** → **句子** → **五个分项色块** → **战绩胶囊** → **下句**
  ⚠️⚠️ 五个分项在稿里是**五个色块**（上标签 12px / 下分数 14px），**不是进度条**。
  ⚠️ 两态共用这一切，只有三处不同：胶囊文案 / 下句 / 分数值。

  ⚠️⚠️ **外框（遮罩 / 居中 / 出入场）由 「ui-dialog」 提供**（B92）：这里只排"面板里有什么"。
  · show 恒 true（在不在由宿主的 wx:if 决定）；
  · closable 恒 false（这是**模态**：必须选「更新」或「保留」，点遮罩不能把它关掉）；
  · bare（无标题、无脚）。
-->
<ui-dialog show="{{true}}" position="center" closable="{{false}}" bare>
  <view class="sp-body">
    <!-- ① 头部：左 = 波形 + 时长（12px）· 右 = 这一把的分（稿 20px/400 绿） -->
    <view class="sp-head">
      <view class="sp-lhs">
        <view class="sp-wave">
          <view class="sp-bar" style="height:16rpx"></view>
          <view class="sp-bar" style="height:32rpx"></view>
          <view class="sp-bar" style="height:48rpx"></view>
          <view class="sp-bar" style="height:32rpx"></view>
          <view class="sp-bar" style="height:16rpx"></view>
        </view>
        <text class="sp-t12">{{durationText}}</text>
      </view>
      <text class="sp-score">{{scoreText}}</text>
    </view>

    <!--
      ② 句子 —— 逐词上色（点一下看完整明细的入口）。
      ⚠️ 间距靠 margin（「mr-1」）：小程序渲染 「<text>」 会把**结尾空格**吃掉 ⇒
         "让词自带空格"那种排法真机上会连成一串。
    -->
    <view class="sp-sentence flex flex-wrap" catchtap="onDetail">
      <text wx:for="{{wordViews}}" wx:key="i" class="text-40rpx leading-[1.5] mr-1 {{item.cls}}">{{item.text}}</text>
    </view>

    <!-- ③ 五个分项色块（稿 57×54 · r8 · pad8 · 上标签下分数） -->
    <view class="sp-parts" wx:if="{{dims.length > 0}}">
      <view class="sp-part" wx:for="{{dims}}" wx:key="key">
        <text class="sp-t12">{{item.label}}</text>
        <text class="sp-t14">{{item.value}}</text>
      </view>
    </view>

    <!-- ④ 战绩胶囊（稿：实心 ink · 40 高 · 331 宽）—— ⭐ 它就是「确认」这一步 -->
    <!--
      ⭐⭐ **AI 锐评**（prd §7.2b；用户 2026-10-15 给的图上就画在这一格）。
      ⚠️ 它点评的是**这一把录音**（成绩单上的批语），所以放在"这一把的分数与分项"下面。
      ⚠️ 拿不到（没配大模型 / 那次调用失败）⇒ **整块不渲染**，不留空框。
    -->
    <text wx:if="{{aiComment}}" class="sp-comment">{{aiComment}}</text>

    <view class="sp-record" bindtap="onConfirm">
      <text class="sp-t14 sp-on-ink">{{pillText}}</text>
    </view>

    <!-- ⑤ 下句（稿 14px · 居中） -->
    <text class="sp-sub">{{subText}}</text>
  </view>
</ui-dialog>
