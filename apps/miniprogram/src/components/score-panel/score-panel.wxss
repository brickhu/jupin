/*
 * ⭐ 出分面板 —— 尺寸照 Figma 588:1791 / 588:1814（1px = 2rpx）。
 * ⚠️ 它落在**白/浅色**浮层上，用页面默认色（不是卡片主题色）：
 *    ink = primary（稿 #2b132c = 我们的 primary）· 分数 = success（稿 #20b99a = 我们的 success）。
 */
/*
 * ⚠️ **外框（遮罩 / 居中 / 出入场 / 卡片本色与圆角）一律由 ui-dialog 提供** ——
 *    本文件只写「面板里怎么排」。它与 .wxss 里的其它规则一起，只描述里面。
 */
.sp-body {
  display: flex;
  flex-direction: column;
}
/* ① 头部：左 波形+时长 · 右 分数 */
.sp-head { display: flex; align-items: center; justify-content: space-between; }
.sp-lhs { display: flex; align-items: center; gap: 16rpx; }

/* 波形 = 5 根矩形（稿 2 宽 · 高 8/16/24/16/8 · gap2） */
.sp-wave { display: flex; align-items: center; gap: 4rpx; height: 48rpx; }
.sp-bar { width: 4rpx; border-radius: 2rpx; background: var(--tk-primary, #2b142c); }

/* 稿 20px/400 · success */
.sp-score {
  font-size: 40rpx;
  line-height: 1;
  font-weight: 400;
  color: var(--tk-success, #21b99b);
}

/* ② 句子（稿 20px/400 · ink）；点它是"看完整明细"的入口 */
.sp-sentence {
  margin-top: 36rpx;
  color: var(--tk-primary, #2b142c);
}

/* ③ 五个分项色块（稿 57×54 · gap12 · r8 · pad8 · 上标签 12px 下分数 14px） */
.sp-parts { display: flex; gap: 24rpx; margin-top: 40rpx; }
.sp-part {
  flex: 1;
  height: 108rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  box-sizing: border-box;
  /**
   * ⚠️ 稿里的浅橙底（「#fbe5ce」）≈ 我们的 accent 兑白 —— 这里直接用稿里的值。
   *    若要收进 token（像 primary/success 那样），说一声我加一个（别在多处散着写）。
   */
  background: #fbe5ce;
  color: var(--tk-primary, #2b142c);
}

/*
 * ⭐⭐ ③.5 AI 锐评（prd §7.2b；用户 2026-10-15 给的图上画在五维与按钮之间）
 * ⚠️ 14px 左对齐、行高 1.6 —— 它是"一段话"，不是标签，所以不居中。
 */
.sp-comment {
  display: block;
  margin-top: 32rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--tk-primary, #2b142c);
}

/* ④ 战绩胶囊（稿 331×40 · 实心 ink · r36）—— ⭐ 它就是「确认」这一步 */
.sp-record {
  margin-top: 42rpx;
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 72rpx;
  background: var(--tk-primary, #2b142c);
  display: flex;
  align-items: center;
  justify-content: center;
}
.sp-on-ink { color: var(--tk-primary-on, #ffffff); }

/* ⑤ 下句（稿 14px · 居中） */
.sp-sub {
  margin-top: 0;
  font-size: 28rpx;
  line-height: 2.2;
  text-align: center;
  color: var(--tk-primary, #2b142c);
}

.sp-t12 { font-size: 24rpx; line-height: 1.4; }
.sp-t14 { font-size: 28rpx; line-height: 1.4; }
