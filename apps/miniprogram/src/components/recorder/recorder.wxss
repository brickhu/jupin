/*
 * ⭐ 录音面板 —— 尺寸照 Figma 583:1727（1px = 2rpx）。见 recorder.wxml 的说明。
 * ⚠️ 稿里这块是**白底 + 红系**（红点 / 计时 / 描边 / 停止钮），不是深色底。
 * ⚠️ 宽度按稿子的**占比**给：稿 366 画在 390 宽的页里 ⇒ 704rpx（750 × 366/390）。
 */
.rc-layer {
  position: fixed;
  inset: 0;
  z-index: 1100;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.18s ease-out;
}
.rc-layer.rc-on { opacity: 1; }

.rc-mask { position: absolute; inset: 0; background: rgba(0, 0, 0, 0.45); }

/* 稿：366×363 / 白 / r16 / 内容左右各留 23 */
.rc-card {
  position: relative;
  width: 704rpx;
  min-height: 726rpx;
  padding: 46rpx;
  border-radius: 32rpx;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* 句子（稿 20px/400 · ink = 我们的 primary） */
.rc-sentence {
  font-size: 40rpx;
  line-height: 1.5;
  font-weight: 400;
  color: var(--tk-primary, #2b142c);
}

/* 红点 + 「录音中，请朗读」 */
.rc-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 34rpx;
}
.rc-dot {
  width: 34rpx;    /* 稿 17 */
  height: 34rpx;
  border-radius: 9999rpx;
  background: var(--tk-error, #ff4c4c);
  animation: rc-pulse 1.1s ease-in-out infinite;
}
@keyframes rc-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.25; }
}
.rc-ink { color: var(--tk-primary, #2b142c); }
.rc-t12 { font-size: 24rpx; line-height: 1.4; }

/*
 * 胶囊（稿：317×48 · 描边 1px 红 · r36 · pad12 · SPACE_BETWEEN）
 * ⚠️ 「margin-top: auto」 把它顶到面板底部 —— 稿里句子与它之间是一大片空白。
 */
.rc-pill {
  margin-top: auto;
  height: 96rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--tk-error, #ff4c4c);
  border-radius: 72rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

/* 计时（稿 14px · 红） */
.rc-time {
  font-size: 28rpx;
  line-height: 1;
  color: var(--tk-error, #ff4c4c);
  font-variant-numeric: tabular-nums;
}

/* 波形（稿 weave 62×24 · 柱色 ink） */
.rc-wavebox {
  width: 124rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rc-wave { width: 124rpx; height: 48rpx; }
/* 还没收到能解码的帧 —— 只留一条中线（绝不摆假波形） */
.rc-midline {
  width: 124rpx;
  height: 2rpx;
  background: var(--tk-primary_50, rgba(43, 20, 44, 0.5));
}
