<!-- ⚠️⚠️ 浮层结构与卡片样式全在本组件的 wxss 里，**不用工具类**（见 ts 文件头） -->
<view class="rd-layer">
  <!-- ⚠️ 遮罩：catchtouchmove 挡住穿透；点它什么都不做（结果必须被看见） -->
  <view class="rd-mask {{entered ? 'rd-mask-on' : ''}}" bindtap="onMaskTap" catchtouchmove="noop"></view>

  <view class="rd-card {{entered ? 'rd-card-on' : ''}}" catchtap="noop" catchtouchmove="noop">

    <!-- ══════════ 检测不合法（失败态）══════════════════════════
         ⚠️ 与出分态**互斥**（页面按 phase 决定传哪个）。
         ⚠️ 结构刻意只有三块：❌ + 一句为什么 + 一个出口 ——
            失败时用户需要的是"接下来怎么办"，不是一堆解释 ✗
         ⚠️⚠️ **绝不出现任何「+0」/「0 🍪」**（prd §7.6）：
            那是把"你什么都没得到"说出来；失败态的正确做法是**整块不提奖励** ✓ -->
    <block wx:if="{{failed}}">
      <view class="rd-head">
        <!-- ⚠️ 红圆 + 白叉：与出分那颗绿圆 + 白勾**同构**（同一个位置、同一种画法）——
             图标字体里没有 check-circle，也没有 close-circle，所以圆都自己画。
             ⚠️ 叉用 mdi:close（字体里**有**这个） -->
        <view class="rd-check rd-check-bad">
          <ui-icon class="rd-check-icon" name="mdi:close" />
        </view>
        <text class="rd-fail-title">检测失败</text>
      </view>

      <text class="rd-fail-detail">{{failDetail || '录音不符合规范，无法检测发音'}}</text>

      <!-- ⚠️ 能量那行小字：失败时**必须说清扣没扣**（"已经扣了" / "失败没扣"）——
           不说的话用户默认自己白花了一次 ✗ -->
      <text class="rd-energy" wx:if="{{energyNote}}">{{energyNote}}</text>

      <!-- ⭐ 唯一出口。文案说"下一步做什么"（重新录一遍），而不是"知道了"——
           失败之后他唯一想做的事就是再读一次 ✓ -->
      <view class="rd-pill" bindtap="onConfirm" hover-class="rd-pill-hover">
        <text class="rd-pill-text">重新录一遍</text>
      </view>
    </block>

    <!-- ── ① 头：✅ + 分数 ｜ 得分详情 ───────────────────────── -->
    <block wx:else>
    <view class="rd-head">
      <!-- ⚠️ 对勾是**绿圆 + 白勾**（设计稿 32×32 r=20 #00DD04）——
           而图标字体里**没有** check-circle（只有 check），所以圆自己画、勾用 ui-icon。
           ⚠️ 别写成 name="mdi:check-circle"：那不在字体里，会渲染成一个**黑豆腐块** ✗ -->
      <view class="rd-check">
        <ui-icon class="rd-check-icon" name="mdi:check" />
      </view>
      <text class="rd-score">{{scoreText}}</text>
      <view class="rd-detail" bindtap="onOpenDetail" hover-class="rd-detail-hover">
        <text class="rd-detail-text">得分详情</text>
      </view>
    </view>

    <!-- ── ② 原文：逐词着色 ─────────────────────────────────
         ⚠️⚠️ **必须是【一个 text 里嵌 text】**，不能是一堆并列的 text ——
             设计稿里这就是"一个 TEXT 节点 + 分段着色"（Figma 的 characterStyleOverrides）。
             并列 text 在小程序里会被当成**块**排：空格丢掉、不折行、整段溢出被裁 ✗
             （2026-10 模拟器截图里就是这个症状：essisnotfinal,failureisnot...）
         ⚠️ 每个词后面**跟一个空格**：text 会保留它，这是词与词之间唯一的间隔 ——
             别指望 margin（在 inline 里不管用）。
         ⚠️ 空数组时整块不渲染（宁可不显示，也不画一句没颜色的原文假装判过了）。 -->
    <text class="rd-sentence" wx:if="{{resultWords.length > 0}}"><text wx:for="{{resultWords}}" wx:key="i" class="{{item.cls}}">{{item.text}} </text></text>

    <!-- ── ③ 底部：状态胶囊（结果态的唯一出口）──────────────────
         ⚠️⚠️ 它同时是**结论**和**出口**：文案有四种（攻克本句 +N 🍪 /
             差X分，攻克本句 / 差X分刷新记录 / 再次攻克 +N 🍪）。
         ⚠️ 不用 ui-button：那颗是实心深黄 + 白字，而设计稿是**浅黄底 + 黑字** ✗ -->
    <view class="rd-pill" bindtap="onConfirm" hover-class="rd-pill-hover">
      <text class="rd-pill-text">{{resultLine ? resultLine.text : '知道了'}}</text>
    </view>

    </block>

  </view>
</view>
