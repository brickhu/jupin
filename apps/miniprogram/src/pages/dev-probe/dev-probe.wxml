<!-- ⚠️ 临时探针页（验完就删）：只回答一个问题 ——
     微信的 createInferenceSession 能不能加载 sherpa-onnx 的关键词检测模型 ✓
     结果直接画在屏幕上，方便真机/模拟器截图 ✓ -->
<view class="px-3 pb-[60rpx] bg-page min-h-[100vh] box-border" style="padding-top:80rpx">

  <view class="text-34rpx font-bold text-ink mb-2">KWS 端侧探针</view>
  <view class="text-24rpx text-faint mb-4">验 createInferenceSession 能否加载 .onnx（不用跑推理）</view>

  <button class="mb-4" bindtap="onRun" disabled="{{running}}">
    {{running ? '正在跑…' : '开始探测'}}
  </button>

  <!-- ⭐ 结论大字：一眼看清成没成 -->
  <view class="text-40rpx font-bold mb-4 {{verdict === 'ok' ? 'text-ok' : verdict === 'fail' ? 'text-bad' : 'text-muted'}}">
    {{verdict === 'ok' ? '✅ 能加载' : verdict === 'fail' ? '❌ 不能加载' : '—'}}
  </view>

  <view wx:for="{{lines}}" wx:key="index" class="text-24rpx text-ink leading-[1.7] break-all">{{item}}</view>
</view>
