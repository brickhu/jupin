<!-- ⚠️ padding-top 由 navTop 给（= 导航栏总高 + 12），这里不要再写 pt-3 —— 见 lib/nav.ts -->
<view class="px-3 pb-[60rpx] bg-page min-h-[100vh] box-border" style="padding-top:{{navTop}}px">

  <!-- ⭐ 统一的自定义导航栏。left 不填 = auto：栈深度 ≥ 1 时画「返回」 -->
  <!-- ⭐ 启动遮罩：身份解析完成前整页盖住（见 components/boot-overlay） -->
  <boot-overlay />
  <nav-bar id="nav" title="参与挑战" />

  <!-- ── 句子加载中 ────────────────────────────────────────── -->
  <view class="card p-3.5 mb-3" wx:if="{{cardPhase === 'loading' && !error}}">
    <text class="text-28rpx text-muted">正在加载句子…</text>
  </view>

  <!-- ── 句子加载失败 ──────────────────────────────────────── -->
  <view class="card p-3.5 mb-3" wx:if="{{cardPhase === 'loading' && error}}">
    <text class="text-28rpx text-bad block leading-[1.6]">{{error}}</text>
    <view class="mt-3">
      <ui-button variant="outline" color="default" width="full" bind:press="onReload">重试</ui-button>
    </view>
  </view>

  <!-- ══ 当前挑战卡：s1 / s2 / s3 共用同一张卡 ══════════════════
       （状态机与每一态的来龙去脉见 reading.ts 的文件头注释）
       ⚠️⚠️ 提交之后的三个态（上传中 / 评测中 / s5 / s6）**不在这张卡里** ——
          用户 2026-09 把它们整体搬进了 components/eval-dialog 的浮层：
          等待期天然禁止点击，结果也不再和句子挤在同一屏。 -->
  <!-- ⭐⭐ **卡片边框和按钮是一致的**（用户 2026-10 定）—— 两边都跟着 hintLevel 走：
         · 录音中（s2）              → **红** border-bad  #dc2626 —— 与红点 / 红计时器 / 红按钮同一套
         · 待提交 · 朗读完整（ok）    → **绿** border-ok   #16a34a —— 与那颗绿 ✓ 同一个色值
         · 待提交 · 只是读错（warn）  → **黄** border-warn #f59e0b —— 与那颗黄按钮同一个色值
         · 待提交 · 被拦住（block）   → 不覆盖，用 card 自己的灰 border-cardline #cccccc
                                        （那时按钮也是灰的 ⇒ 仍然"和按钮一致"）
       ⚠️ 为什么不只是"录音红、待提交绿"：按钮已经按三档上色了（绿 / 黄 / 灰），
          边框只跟两档的话，**读错那一档会出现"黄按钮 + 绿边框"** ——
          两个颜色说的是同一件事，不该互相打脸。

       ⚠️ 判据**从已有的 phase / hintLevel / canSubmit 派生**，不新增"边框色"字段 ——
          新增字段就等于多几个"忘了同步"的地方（这类 bug 这个页面犯过几次）。
       ⚠️⚠️ 与 .card 是"同特异度、后写的赢"（都设 border-color）：靠产物里
          .border-bad / .border-ok / .border-warn 排在 .card 之后（工具类都在 shortcut 之后）。
          已核对 uno.wxss 确实如此；改 uno 配置时要重新确认，
          否则会**静默失效**：边框不变色，而没有任何报错。
       ⚠️ 只换**颜色**，宽度仍是 card 里的 border-2 —— 不动尺寸，卡片不会因此跳一下。 -->
  <!-- ⚠️ 结果态（s5/s6）**不套那三档边框色**：
       cardPhase 把结果也映射成 's3'，于是它会顶着"可以提交"的绿边 ✗ ——
       而那时卡片里画的是结果，不是待提交的录音 ✓ -->
  <view class="card p-3.5 mb-3 {{phase === 's5' || phase === 's6' ? '' : cardPhase === 's2' ? 'border-bad' : cardPhase === 's3' && hintLevel === 'warn' ? 'border-warn' : cardPhase === 's3' && canSubmit ? 'border-ok' : ''}}"
        wx:if="{{cardPhase === 's1' || cardPhase === 's2' || cardPhase === 's3'}}">

    <!-- ══════════ ★ 结果态（用户 2026-10 定：结果**就是卡片的一个状态**）══════════
         ⚠️⚠️ 原来它是一个浮层（components/result-dialog），盖住整页、还要处理
             "能不能划掉 / 要不要重新弹" ✗ —— 现在它只是这个卡片的又一个状态，
             和 s1/s2/s3 同一套画法 ✓
         ⚠️ 为什么这样更好：① 不挡任何东西（下面的历史、参与都看得见）
             ② "必须被看见"**自然成立** —— 回到这一页就看见卡片上的结果 ✓
             ③ 状态维持与卡片共用同一套缓存（loadLastResult）✓
         ⚠️ 下面判的是 phase，**不是 cardPhase** —— 因为 cardPhase 把 s5/s6
            都映射成 's3'（为了让卡片照常画），拿它判"现在是不是结果态"会永远为真 ✗ -->
    <block wx:if="{{phase === 's5' || phase === 's6'}}">

      <!-- ── 检测不合法（s6）：❌ + 一句为什么 ────────────────────
           ⚠️⚠️ **绝不出现任何「+0」/「0 🍪」**（prd §7.6）—— 失败态整块不提奖励 ✓ -->
      <block wx:if="{{phase === 's6'}}">
        <view class="flex items-center">
          <!-- ⚠️ 红圆 + 白叉，与出分那颗绿圆 + 白勾同构；
               图标字体里没有 close-circle，所以圆自己画、叉用 mdi:close -->
          <view class="rd-check rd-check-bad">
            <ui-icon class="rd-check-icon" name="mdi:close" />
          </view>
          <text class="rd-fail-title">检测失败</text>
        </view>
        <text class="rd-fail-detail">{{failDetail || '录音不符合规范，无法检测发音'}}</text>
      </block>

      <!-- ── 出分（s5）：✅ + 分数 ｜ 得分详情 + 逐词原文 ───────────── -->
      <block wx:else>
        <view class="flex items-center">
          <view class="rd-check">
            <ui-icon class="rd-check-icon" name="mdi:check" />
          </view>
          <text class="rd-score">{{scoreText}}</text>
          <view class="rd-detail" bindtap="onOpenDetail" hover-class="rd-detail-hover">
            <text class="rd-detail-text">得分详情</text>
          </view>
        </view>

        <!-- ⚠️⚠️ 逐词必须【一个 text 里嵌 text】：设计稿就是一个 TEXT 节点 + 分段着色。
             并列 text 在小程序里会被当**块**排 —— 空格丢掉、不折行、整段溢出被裁 ✗
             ⚠️ 词与词之间只靠**每个词后面那个空格**（text 会保留它），不能指望 margin -->
        <text class="rd-sentence" wx:if="{{resultWords.length > 0}}"><text wx:for="{{resultWords}}" wx:key="i" class="{{item.cls}}">{{item.text}} </text></text>
      </block>

      <!-- ── 出口：统一叫「重新挑战」，结论放在它**下面**（用户 2026-10 定）─────
           ⚠️ 按钮文案**统一**（原来是把结论写进按钮里）——
              按钮的职责是"告诉我点它会怎样"，结论的职责是"告诉我刚才怎么样"；
              两件事塞进一颗按钮，读起来会像"点了才能拿到那个结论" ✗
           ⚠️ 结论只在**出分**时给（失败态没有结论可给） -->
      <view class="rd-pill" bindtap="onRetryChallenge" hover-class="rd-pill-hover">
        <text class="rd-pill-text">重新挑战</text>
      </view>
      <text class="rd-conclusion" wx:if="{{phase === 's5' && resultLine}}">{{resultLine.text}}</text>
      <!-- ⚠️⚠️ **出分态不显示能量那行小字**（用户 2026-10 定）：
           "本次评测消耗 2 点，剩余 9959 点" 是**账目**，不是这一把的结论 ——
           它挤在结论和按钮下面，把"我读得怎么样"这条主线搅浑了 ✗
           余额随时可以在能量页看 ✓
           ⚠️ 但**失败态仍然要显示**（见上面的 rd-energy 分支）：那一次用户必须知道
              "能量到底扣没扣"，否则他会默认自己白花了一次 ✗ -->
      <text class="rd-energy" wx:if="{{phase === 's6' && energyNote}}">{{energyNote}}</text>

    </block>

    <!-- ⚠️ 下面整块是 s1/s2/s3 —— 结果态时不画（与上面那个 wx:if 互斥） -->
    <block wx:else>


    <!-- ── s1 / s3 顶行：标准音试听（▶ + 时长）｜IPA 开关 ────── -->
    <view class="flex items-center justify-between mb-3" wx:if="{{cardPhase === 's1' || cardPhase === 's3'}}">
      <view class="flex items-center">
        <!-- ⭐⭐ **用全站唯一的 audio-button**（用户 2026-10 定：与列表页的播放控件统一）。
             ⚠️ 原来这里是自己用 ui-button 拼的，理由是"设计稿上这颗是实心浅灰圆、
                而 audio-button 的未播放态是描边"。**那个理由现在作废** ——
                同一个"播放"动作在两个页面上长得不一样，比描边还是实心更值得在意：
                用户会以为它们是两种不同的东西。
             ⚠️⚠️ **尺寸与配色都要和列表页那颗一字不差**（用户 2026-10 定）：
                size="sm"（ab-sm = 44rpx，与 arena-card 同一个数）；
                配色传**卡片的前景色 / 底色**（默认主题 = 黑描边 + 白图标），
                见 reading.ts 的 playFill / playInk。
                「用同一个组件但一个蓝一个大」不算统一 —— 用户一眼看出来的正是这两样。
             ⚠️ 只在这一句真的灌了标准音时才渲染（canPlayAudio）：
                点了没反应的图标比没有这个按钮更难排查。
             ⚠️⚠️ **当初不敢用 loading 状态的那个坑，audio-button 没有** ——
                它的 onTap **只检查 disabled**，转圈时点击照常抛事件。
                （ui-button 的 loading 会吞掉点击，那是给"防重复提交"用的；
                  而这颗是**开关** —— 取音卡住时点不动就永远卡住了，
                  用户 2026-09 报的"播放按钮不能播放"就是这个形状。）
                ⇒ 取音中直接用 audio-button 的 loading 态，再点 = 重试（见 onPlaySentence）。
             ⚠️ 右边的时长也交给它（showDuration）—— 格式只在这里定一次。
                拿不到时长时 durationMs 是 0，formatDuration(0) 返回空串 ⇒ 那几个字不渲染。 -->
        <audio-button wx:if="{{canPlayAudio}}" size="sm"
                      state="{{sentenceState === 'loading' ? 'loading' : sentenceState === 'playing' ? 'playing' : 'unplay'}}"
                      showDuration="{{true}}" durationMs="{{stdDurationMs}}"
                      fill="{{playFill}}" ink="{{playInk}}"
                      bind:play="onPlaySentence" />
      </view>
      <!-- ⭐ IPA 胶囊 = 切换「单词下方显示音标」；开着时变实心，状态一眼可见 -->
      <ui-button size="sm" variant="{{ipaOn ? 'fill' : 'ghost'}}" color="{{ipaOn ? 'brand' : 'default'}}"
                 bind:press="onToggleIpa">IPA</ui-button>
    </view>

    <!-- ── s2 顶行：红点 + 录音中…｜右侧红色计时器 ───────────── -->
    <!-- -- 给改代码的人 --
         min-h-[56rpx] 是**故意的**：这一行只有一个小红点和几个字，而 s1/s3 那一行
         有播放钮 + IPA 胶囊 —— 不撑高的话，s1 → s2 那一下整张卡的内容会**往上跳**
         （用户 2026-09 报的「s2 顶栏和 s1 高度不一致」）。

         ⚠️⚠️ **这个数 = s1/s3 那一行最高的那个**，不是播放钮的高度：
              · 播放钮 audio-button size="sm" = **44rpx**（ab-sm）
              · IPA 胶囊 ui-button   size="sm" = **56rpx**（ub-s-sm）  ← 现在由它撑高
             ⇒ 取 56。
         ⚠️ 这个数跟着播放钮走过了两趟，两趟都可能把那个跳动放回来：
             76（ui-button ub-s-md）→ 64（ab-md）→ **56**（ab-sm，播放钮让位给 IPA 胶囊）。
             下次再动播放钮或 IPA 的尺寸，**先看谁更高**，再改这里。 -->
    <view class="flex items-center justify-between mb-3 min-h-[56rpx]" wx:if="{{cardPhase === 's2'}}">
      <view class="flex items-center">
        <!-- ⭐ 录音指示点 —— **呼吸动效**（用户 2026-10 定）：一鼓一收，一眼看出"还在录"。
             ⚠️ 动效本身在页面 wxss 的 .rec-breath 里（scale + opacity 一起走）——
                只做透明度在小圆点上看不出来，见 reading.wxss 的说明。
             ⚠️ **只在 s2 出现**：这个动的点本身就是"正在录"的信号，
                静止的红点和一个普通的装饰圆没有区别。 -->
        <view class="w-[20rpx] h-[20rpx] rounded-full bg-bad shrink-0 rec-breath"></view>
        <text class="text-28rpx text-body ml-2">录音中...</text>
      </view>
      <!-- -- 给改代码的人 --
           时间在 TS 里格式化（见 mmss）：WXML 不做任何计算。
           字号取 32rpx：s1/s3 那一行右边是 ub-s-md 的 IPA 胶囊（28rpx），
           而这是一个**正在走的计时器** —— 比胶囊里的静态标签再重一档才读得清。 -->
      <text class="text-32rpx text-bad">{{elapsedText}}</text>
    </view>

    <!-- ── s1 / s2 / s3 主体：句子（逐词渲染）────────────────────
         ⚠️ 逐词是为了「点词听发音」和「词下挂音标」两件事，下标与正文 words[] 一一对应。
         ⭐ **录音时也保留音标**（用户 2026-10 定，改掉了原来的口径）：
            早先的口径是「录音中不显示音标，少一层干扰」（设计稿）。
            ⚠️ 但**录音这个动作本身**就改变了这件事：用户是**一边录一边读**的
            （无论按住还是点击都一样），音标正是他此刻要用的东西 ——
            录的时候藏起来，等于把参考书合上再让你念。
            ⇒ 只要用户开着 IPA 开关，就在整个朗读过程里一直显示。 -->
    <view class="flex flex-wrap" wx:if="{{cardPhase === 's1' || cardPhase === 's2' || cardPhase === 's3'}}">
      <!-- ⚠️ data-i 带的是**下标**而不是词本身：同一句里 "the" 会出现两次，
           按文本找必然指错那一个（见 reading.ts 的 onPlayWord）。 -->
      <view class="flex flex-col items-center mr-2 mb-1" wx:for="{{words}}" wx:key="i"
            data-i="{{item.i}}" bindtap="onPlayWord">
        <!-- ⚠️ px-1 mr-1 的写法与迁移前一致：高亮底色的内边距不跟着 cls 走，着色时整行不抖 -->
        <!-- ⭐⭐ **定稿后的预检色**（只判"读到了没"，与提交后的评分色无关，见 prd 7.2）。
             两态**互斥**，而且**线型也要分开**（用户 2026-10 定）：

               · 没读准 → **黄色 + 黄色实线**（「text-warn underline decoration-warn」）
                 实线＝"这儿有东西，只是存疑"；黄是"待确认"，不是"错"
               · 没读到 → **灰色 + 灰色点线**（「text-muted underline decoration-dotted decoration-muted」）
                 点线＝"这儿空着"；灰是"不下判断"
               · 都没有 → 正常（text-ink）

             ⚠️⚠️ **不准用红**：红是**判错**的颜色（theme 的 bad），提交后的正式标色才用它。
                这里两个状态都只是**预检**，用红等于替用户下结论，也会和正式标色撞车。
             ⚠️ **录音过程中不逐词变色**（用户 2026-10 定）：插件的中间结果约 550ms 才回一次，
                字是一跳一跳地亮，延迟体验不理想 —— 与其做个迟钝的实时反馈，不如不做。
                现在只在**松手定稿那一刻**算一次，是即时的、准的。
             ⚠️ 用**下划线**而不是填充色块：提交后的正式标色是填充色块，
                两套视觉语言分开，用户才不会以为系统在自相矛盾。 -->
        <text class="text-44rpx leading-[1.35] px-1 {{item.misread ? 'text-warn underline decoration-solid decoration-warn' : item.missed ? 'text-muted underline decoration-dotted decoration-muted' : 'text-ink'}} {{playingWord === item.i ? 'bg-brand_10 rounded-1' : ''}}">{{item.text}}</text>
        <!-- ⚠️ 没有音标（老正文 / 查不到）时这一行不渲染，不占位 -->
        <text class="text-20rpx leading-[1.4] text-faint" wx:if="{{ipaOn && item.ipa}}">{{item.ipa}}</text>
      </view>
    </view>

    <!-- ⚠️ 译文**不放**（用户 2026-09 明确：阅读卡片不用显示翻译）。
         朗读练习看中文是上一版的旧口径，已作废 —— 别看着"空了一块"又加回来。 -->

    <!-- ── 底部录音键：**同一颗按钮，两种状态**（用户 2026-10 定）─────────
         ⭐⭐ 早期版本在录音时会换成「↺ ｜ 实时波形 ｜ 松手结束」一整行，用户明确要去掉：
            录音中**不换布局**，就改这一颗按钮的文字与配色 —— 位置不跳，视线不用移。

         ⚠️ 按住说话取代了原来那条实时波形的作用：**按住的物理动作本身就是"我在录"**，
            而"松手 = 读完了"语义正好对上（见 prd 7.2）。
            ⇒ 波形连同它的画布、帧解码一整套都删掉了（插件录音本来就拿不到帧）。

         ⚠️ 三个触摸事件都要接，缺一不可：
              · touchstart = 开始录
              · touchend   = 松手，说完了
              · ⚠️ **touchcancel = 手指滑出按钮**（这时**没有** touchend）——
                漏了它录音就停不下来，用户要等 30 秒的 duration 兜底。
         ⚠️ 放在外层 view 上而不是 ui-button 上：ui-button 只发「press」（tap），
            但它用的是 catchtap、**不拦触摸事件**，所以触摸照常冒泡到这一层。
         ⚠️ 红色是设计稿口径（录音这个动作走语义色，不是品牌紫）：
            待录 = 红描边；录音中 = **红实心**（状态差别一眼可见，且不新增颜色）。
         ⭐ **松手后还有一段"识别中…"** —— 那是松手缓冲期（见 reading.ts 的 RELEASE_HANGOVER_MS）：
           ⚠️ 那段缓冲已经删了（它本来是为流式识别存在的，识别随插件一起去掉）。
            ⚠️ 按钮必须**立刻**变字：还写着「结束」的话，用户会以为自己没点上。 -->


    <!-- ⭐⭐ **点一下开始录音 ⇒ 进入「录音模式」**（用户 2026-10 定）。
         ⚠️ s1 与 s2 是**两个不同的界面**，不是"同一颗按钮换个字" ✗：
              s1 = 一颗 CTA —— 还没开始，用户只需要知道"点哪里"
              s2 = **录音模式** —— ↺（禁用占位）｜ 实时波形 ｜ 结束录音，三样同排一行
         ⚠️ s2 那颗「结束录音」**必须够得着**：它的位置与 s1 的 CTA **完全重合**，
            手指不用移动就能点到 ✓
            ⭐ 它历史上被撤过一次 —— 按住说话时手指正压在那颗按钮上、够不着它，
              于是换成了一句"松手结束"的提示。**改成点击之后它又回来了** ✓
         ⚠️ 三态里的圆钮一律 size="xl"（= 100rpx）：s2 的结束录音、s3 的 ↺ / ✓、
            s1 的 CTA 都是这一档。它们在同一张卡里、同一个位置、隔一帧就换 ——
            尺寸不一致在切换时会明显"跳一下" ✗ -->
    <view class="mt-5" wx:if="{{cardPhase === 's1'}}">
      <!-- ⚠️⚠️ **事件必须挂在 ui-button 自己的 bind:press 上，不能挂外层 view 的 bindtap** ✗
           原因在 ui-button.ts 里写着：它的根节点用 **catchtap**（截住原生冒泡）+
             事件名不叫 tap —— 就是为了防止"原生 tap 与外层 tap 各触发一次"。
           ⇒ 挂在外层的 bindtap **永远收不到**（点了毫无反应 ✓ 这就是踩过的坑）
           ⚠️ （旧代码之所以能挂在外层，是因为它挂的是 touchstart/touchend ——
              触摸事件是另一条链、会冒泡 ✓ 而 tap 被 catchtap 截断了 ✗） -->
      <ui-button variant="outline" color="error" size="xl" width="full" icon="mdi:microphone"
                 bind:press="onTapRecord">
        点击录音并朗读
      </ui-button>
    </view>

    <!-- ── s2：**录音模式**（↺ 禁用占位 ｜ 实时波形 ｜ 结束录音）────────── -->
    <view class="mt-5 flex items-center" wx:if="{{cardPhase === 's2'}}">
      <!-- ⚠️ 录音中这颗 ↺ 是**禁用的**（用户已确认：录音中不给重录，只作占位）——
           它与 s3 那颗 ↺ 同位置、同尺寸，所以切过去时不会跳 -->
      <ui-button onlyIcon="{{true}}" size="xl" variant="ghost" color="default" disabled="{{true}}">
        <text class="text-36rpx text-ink">↺</text>
      </ui-button>

      <view class="flex-1 min-w-0 mx-3">
        <!-- ⭐ 实时波形：回答的是**用户唯一能自查的问题** ——
             「麦克风到底收到我的声音没有」。没有它，用户只能靠"读完了分数很低"倒推，
             而那时已经晚了 ✗
             ⚠️ 用 canvas 而不是一排 view：一帧上千个采样点，节点方案既扛不住也会糊成一块
             ⚠️ 尺寸必须由 CSS 给（canvas 默认 300×150），backing store 在 JS 里按 dpr 开 -->
        <canvas type="2d" id="wave" class="w-full h-[64rpx]" wx:if="{{waveOn}}"></canvas>
        <!-- ⚠️ 还没收到**能解码的帧**时只留一条中线 —— 绝不摆一条不动的假波形 ✗
             那比没有更糟：会让人以为是自己手机 / 麦克风的问题（踩过的坑）✓ -->
        <view class="h-[64rpx] flex items-center" wx:else>
          <view class="w-full h-[4rpx] rounded-full bg-line"></view>
        </view>
      </view>

      <!-- ⭐ **结束录音**（手动）—— 不点也行：读完静音自停、30 秒也会超时兜底 ✓
           ⚠️ 「识别中…」那一态要 disabled：那时已经说了停、正在定稿，
              还画成可点的红实心钮会让用户以为自己没点上 ✗ -->
      <view class="shrink-0">
        <!-- ⚠️ 同上：事件挂 bind:press，不挂外层 view 的 bindtap ✗
             ⚠️ disabled 时 ui-button **自己就不再 triggerEvent** ⇒ 定稿中那几百毫秒
                点它确实没反应 ✓ 那是对的（onTapRecord 里也有 phase 判断兜底 ✓） -->
        <ui-button variant="fill" color="error" size="xl" disabled="{{releasePending}}"
                   bind:press="onTapRecord">
          <text class="text-34rpx">{{releasePending ? '识别中…' : '结束'}}</text>
        </ui-button>
      </view>
    </view>

    <!-- ⭐ 交互说明（s1 / s2 共用同一块、位置固定 ⇒ 卡片高度不变、按钮不跳） -->
    <view class="mt-3 px-2 text-center" wx:if="{{cardPhase === 's1' || cardPhase === 's2'}}">
      <!-- ⚠️⚠️ **这是用户唯一看到的操作说明**，交互改了它必须跟着改 ✗
           ⭐ 顺带把"自动结束"说出来：不告诉他的话，用户会一直等着自己点结束，
              而其实读完静音一会儿就自动进 s3 了 ✓ -->
      <text class="text-24rpx leading-[1.6] text-faint">{{releasePending ? '正在识别你的朗读，请稍等' : cardPhase === 's2' ? '读完会自动结束，也可以点「结束」' : '点一下开始朗读，读完会自动结束'}}</text>
    </view>

    <!-- ── s3 底部：↺ 重录｜试听我的录音｜绿色 ✓（确认 = 提交评测）── -->
    <view class="mt-5" wx:if="{{cardPhase === 's3'}}">
      <view class="flex items-center">
        <!-- ⭐ 检测中**禁用重录**（用户 2026-10 定）：
             ⚠️⚠️ 新流程下确认之后卡片留在 s3 ⇒ 这颗钮从此有机会被按到，
                 而按下去会清掉本地缓存、服务端那一笔却被孤立（见 reading.ts 的 clearAttempt）。
                 ⚠️ 逻辑上也挡了一道（clearAttempt 里的守卫）—— UI 与逻辑**两处都要有**，
                    因为"看起来能按、按了没反应"比直接变灰糟得多。 -->
        <ui-button onlyIcon="{{true}}" size="xl" variant="ghost" color="default"
                   disabled="{{detecting}}" bind:press="onRestart">
          <text class="text-36rpx text-ink">↺</text>
        </ui-button>

        <!-- ⚠️ 这颗是 outline 胶囊（设计稿口径），所以用 ui-button 而不是 audio-button：
             audio-button 只有圆钮。图标走 iconify 名（mdi:play / mdi:stop） -->
        <view class="flex-1 min-w-0 mx-3">
          <ui-button variant="outline" color="default" size="md" width="full"
                     loading="{{replayState === 'loading'}}"
                     icon="{{replayState === 'playing' ? 'mdi:stop' : 'mdi:play'}}"
                     bind:press="onReplay">{{recordDurationText}}</ui-button>
        </view>

        <!-- ⭐⭐ **漏读时这颗钮要禁用 + 变灰**（用户 2026-10 定）：
             它是"这一步过不去"，不是"你可以考虑一下" —— 留着可以按，
             用户会反复按、反复没反应，而下面那行字已经说了要重新朗读。
             ⚠️ **颜色也跟着 hintLevel 走**（用户 2026-10 定）：ok → 绿（success）、
                warn（只是读错 / 读得慢）→ **黄（warning #f59e0b）**、block → 灰（default）。
                按钮和下面那行提示说的是同一件事，不该一个绿一个黄 ——
                卡片边框同理（见本页开头那段）。
             ⚠️ 变灰用 color="default"（#111111）+ disabled（opacity .45），
                落在白卡上就是灰的；只 disabled 的话是**半透明的绿**，那不是灰。
             ⚠️ 颜色与 disabled 都从 hintLevel / canSubmit **派生**，不新增字段 ——
                写两遍（或存一份）迟早只改一处。 -->
        <!-- ⭐⭐ 检测中这颗 ✓ 变**转圈 + 禁用**（用户 2026-10 定）——
             这就是"确认之后弹窗关掉、由卡片表达正在检测"的那一处。
             ⚠️ loading 与 disabled **都要给**：loading 只是转圈（ui-button 的 loading
                本来就吞点击，但那是一条隐式行为）；disabled 让它的**颜色**也变灰，
                两者合起来才是"正在检测，别再点"。
             ⚠️ 判据是 detecting（由 phasePatch 派生），不是自己再算一遍 phase。 -->
        <ui-button onlyIcon="{{true}}" size="xl" variant="fill"
                   color="{{hintLevel === 'ok' ? 'success' : hintLevel === 'warn' ? 'warning' : 'default'}}"
                   loading="{{detecting}}"
                   disabled="{{!canSubmit || detecting}}" bind:press="onSubmit">
          <!-- ⚠️⚠️ **✓ 的颜色要跟着按钮状态走**（用户 2026-10 定）：
               disabled 时底是 color="default" 的 #111111 + opacity .45（≈#999 中灰），
               而正常态的字是 text-ink —— **和 #111 的底同色，等于没画**。
               ⇒ 禁用时换成**白色 60%**，那颗勾才看得见。
               ⚠️ 注意透明度的叠加：按钮自己还有 disabled 的 opacity .45，
                  所以 60% 白最终落在底上大约 #d4d4d4（灰底 ≈#949494）——
                  对比度不高但看得清。嫌弱就把 opacity-60 提到 80。 -->
          <!-- ⚠️ 检测中不画这颗勾：转圈已经占着同一格，两个叠在一起是一团糊 -->
          <text class="text-36rpx {{canSubmit ? 'text-ink' : 'text-white opacity-60'}}" wx:if="{{!detecting}}">✓</text>
        </ui-button>
      </view>

      <!-- ⭐⭐ **提交按钮下面那一行提示**（用户 2026-10 定）—— 见 lib/submit-hint.ts。
           ⚠️ 它替代了早先的弹窗：信息在按提交**之前**就摆在那里，看得见、不用被打断。
           ⚠️ 三档（ok / warn / block）说的**不只是颜色**，还有"这一步过不过得去"：
               · ok    ⇒ 绿 —— 可以提交
               · warn  ⇒ 黄 —— 只是建议（读错 / 读得慢），**按钮照样能按**
               · block ⇒ **红 —— 拦住了**（漏读），提交按钮同时**禁用 + 变灰**
           ⚠️ 措辞与档位一致：warn 那两句是「建议…」，block 那两句是「**请重新朗读**」——
              按钮都灰了，措辞不能还留着商量的余地。 -->
      <view class="mt-3 px-2 text-center">
        <!-- ⭐ 三档颜色由 hintLevel 一档决定（与文案、与按钮可用性同源）：
               ok ⇒ 绿（可以提交）· warn ⇒ 黄（只是建议）· **block ⇒ 红（拦住了，只能重录）**。 -->
        <text class="text-24rpx leading-[1.6] {{hintLevel === 'ok' ? 'text-ok' : hintLevel === 'block' ? 'text-bad' : 'text-warn'}}">{{hintText}}</text>
      </view>

      <!-- ⚠️ 这一态**不再显示**「评测消耗能量2，剩余3」（用户 2026-09 定：删掉）。
           能量那件事挪到**提交那一步的确认弹窗**里说（显示「本次消耗 N 点，确认后剩 M 点」），
           而且那时数字是**服务端权威余额**，比这里拿缓存估的准。
           ⇒ 别看着这块"少了一行"又加回来。 -->
    </view>

    </block>

  </view>

  <!-- ══ 评测弹窗 ══════════════════════════════════════════════
       ⚠️⚠️ 提交评测之后的三个态（上传中 / 评测中 / 出分 s5 / 失败 s6）**都在这一层里**
          （用户 2026-09 定）：等待期禁止点击由遮罩天然保证，结果也不和句子挤在同一屏。
       ⚠️ 它自己判断画不画（看 mode + phase），这里不需要 wx:if。
       ⚠️ 两块各由谁来决定：
          · mode=precheck（提交前确认能量）—— confirmOpen 说了算，
            用 phase='precheck' 表示"正在问权威余额"；
          · mode=submitting（评测过程与结果）—— 原来的 s4/s5/s6。
       ⚠️ 四个回调都由本页实现：onConfirmResult（关窗 + 回 s1 + 这一次进历史）/
          onOpenDetail（navigateTo pages/challenge）/ onConfirmStart（真的开始提交）/
          onConfirmCancel（取消，什么都没发生）/ onConfirmGoEnergy（去能量页）。 -->
  <!-- ⭐⭐ **弹窗只在两种时刻出现**（用户 2026-10 定的新流程）：
       ① 提交前确认能量       → mode='precheck'（confirmOpen）
       ② 出分 / 检测失败      → mode='submitting'（phase = s5 / s6）
       ⚠️⚠️ **检测中（uploading / scoring）弹窗是关掉的** —— 等待状态改由**卡片**表达
           （✓ 转圈、↺ 变灰，见上面 s3 那一段）。这就是这次改动的主线：
           弹窗不再"一路盖到底"，它只负责"确认"和"给结果"两件事。
       ⚠️ 判据写成**派生表达式**而不是一个 data 字段：它与 confirmOpen / phase 必须永远一致，
          存一份迟早有一处忘记更新（症状是"检测中弹窗还盖着"或者"出分了弹窗不出现"）。
       ⚠️⚠️ 这里给的是**原始 phase**（弹窗的九个态它全要），不是 cardPhase ——
       卡片看 cardPhase（检测中停在 s3），弹窗看 phase（要区分 uploading / scoring / s5 / s6）。
       两者由 reading.ts 的 phasePatch() 一起写。
       ⚠️ 注释里**不能写反引号** —— 小程序的 wxss 编译器会直接报 unexpected（这条是被 lint 挡下来的）。 -->

  <!-- ⭐ 确认能量那一层：**只在 confirmOpen 时存在**（用户 2026-10 定）。
       ⚠️⚠️ 确认之后它整个消失 —— 检测期间页面**没有遮罩**，
          等待由卡片上那三颗钮表达（✓ 转圈、↺ 变灰）。
       ⚠️ 这里**不再传 mode**：它只做确认能量一件事，存在与否就够了
          （以前用 mode 在同一组件里切四种形态，结果层与卡片的判据不一致，
           检测期间只剩一层黑遮罩、没有卡片 ✗）。
       ⚠️ 结果（含检测失败）**并进了上面那张朗读卡片**（用户 2026-10 定）——
           它现在是卡片的一个状态，不再是浮层 ✓ -->
  <eval-dialog wx:if="{{confirmOpen}}"
               phase="{{phase}}"
               costEnergy="{{costEnergy}}" balanceEnergy="{{confirmEnergy}}"
               bind:start="onConfirmStart" bind:cancel="onConfirmCancel"
               bind:goEnergy="onConfirmGoEnergy" />

  <!-- ── 通用错误条（横跨六态，不改变状态）─────────────────────
       ⚠️ 麦克风没授权、能量不够、上传失败、轮询断网……都在这里说一句人话。
          s6 那句「录音不符合规范」不走这里 —— 它是 s6 的正文。
       ⚠️ 句子还没拉到时的错误已经在上面那张卡里了，别重复显示。 -->
  <view class="mb-3 bg-red-50 border-l-[6rpx] border-solid border-bad rounded-1 p-2.5"
        wx:if="{{error && cardPhase !== 'loading'}}">
    <text class="text-24rpx text-bad leading-[1.6]">{{error}}</text>
  </view>

  <!-- ══ 下方「历史挑战」——我在**这一句**上还读过哪几次 ═══════════
       ⚠️ 与「我的挑战」列表（pages/me/challenges）不是一回事：那边一行还要显示句子本身，
          而这一页的句子就在上面 —— 一行只留三件事：第几次 · 什么时候 · 多少分。
       ⚠️ 列表里**不含当前这一次**（口径与实现见 lib/article-history.ts）。
       ⚠️ 只在句子已经拉到时才画这一块：句子都没有的时候，这一页的主体现在是
          「正在加载句子…」/「重试」，下面再挂一段历史会喧宾夺主。 -->
  <view class="mt-3" wx:if="{{cardPhase !== 'loading'}}">
    <!-- ⚠️ 表头只剩分组名（用户 2026-09）：原来右边还有一句「共 N 次 · 最高 X」——
         那个数现在由**下面的「我的参与」摘要卡**说（而且那张说的是"含当前这一把"的全部，
         与历史行的口径不同，见 lib/article-history.ts）。同一件事不摆两处。 -->
    <view class="flex items-baseline justify-between px-1 mb-2">
      <text class="text-26rpx text-muted">历史挑战</text>
    </view>

    <!-- ══ 我的参与（摘要卡）——用户 2026-09：做成 pages/me/participations 那样的卡片 ══
         ⚠️ 四个数与「我的挑战」列表同一套：**挑战 / 最高 / 位列 / 最低**，
            上标签下数字、四等分（那页就是这两行结构，别在这儿改成别的排法）。
         ⚠️⚠️ 它与下面「历史挑战」的行**口径不同**：这张卡说的是"我在这一句上的全部"
            （含当前这一把），行那一列免掉"当前这一次" —— 见 lib/article-history.ts 的说明。
         ⚠️ 只在真的拿到过数据时画（historyReady）：否则会先闪一张全是「—」的卡。 -->

    <!-- ⭐ 这一句一共攒了多少饼干（用户 2026-10 定）
         ⚠️⚠️ **屏幕永不出现「0 🍪」**（prd §7.6）—— 一句都没攻克过时这一行**整块不画**，
            而不是画一行"0 🍪"把"你什么都没得到"说出来。
         ⚠️ 数量由服务端的 sentenceCookies 给（按 article 汇总、只算已领取的），
            端侧不自己加：领取那一刻只在"刚领到的 +N"上补一次（见 reading.ts）。 -->
    <view class="card p-4 mb-3 flex items-center" wx:if="{{sentenceCookies > 0}}">
      <text class="text-26rpx text-muted flex-1">这一句共攒了</text>
      <text class="text-32rpx font-bold text-ink">{{sentenceCookies}}</text>
      <text class="text-32rpx ml-1">🍪</text>
    </view>
    <view class="card p-4 mb-3" wx:if="{{historyReady}}">
      <view class="flex">
        <view class="flex-1">
          <text class="text-22rpx text-faint block">挑战</text>
          <text class="text-30rpx font-semibold text-ink">{{summary.attemptsText}}</text>
        </view>
        <view class="flex-1">
          <text class="text-22rpx text-faint block">最高</text>
          <text class="text-34rpx font-bold text-brand">{{summary.bestScoreText}}</text>
        </view>
        <view class="flex-1">
          <text class="text-22rpx text-faint block">位列</text>
          <text class="text-30rpx font-semibold text-ink">{{summary.rankText}}</text>
        </view>
        <view class="flex-1">
          <text class="text-22rpx text-faint block">最低</text>
          <text class="text-30rpx font-semibold text-muted">{{summary.lowestScoreText}}</text>
        </view>
      </view>
    </view>

    <view class="card">
      <!-- ── 正在取（首次进入）────────────────────────────────── -->
      <view class="p-5" wx:if="{{historyLoading}}">
        <text class="text-28rpx text-muted">正在取历史记录…</text>
      </view>

      <!-- ── 一条都没有 ────────────────────────────────────────
           ⚠️ 它和「正在取」是两件事：空列表配「正在取…」会让人一直等下去（同我的挑战列表）。
           ⚠️ 这条分支只有**真的读到了零条**才算数 —— 拉失败时进下面那条
              "取不到"，不能报「这句上还没有别的记录」（那是句假话）。 -->
      <view class="px-5 py-8 text-center" wx:elif="{{historyAttempts === 0 && !historyError}}">
        <text class="text-26rpx text-faint leading-[1.6]">这句上还没有别的记录 —— 再读一次，这里就会有第二条。</text>
      </view>

      <!-- ── 取不到（且一条都没拿到）→ 一句话 + 重试 ───────────── -->
      <view class="p-5" wx:elif="{{historyAttempts === 0}}">
        <text class="text-28rpx text-bad leading-[1.6]">{{historyError}}</text>
        <view class="flex justify-end mt-2">
          <text class="text-26rpx text-brand" bindtap="onRetryHistory">重试</text>
        </view>
      </view>

      <!-- ── 一行 = 我在这一句上的一次挑战 ──────────────────────
           ⚠️ 点进去看的是**那一次**的结果屏（pages/challenge?sid=…），
              不是当前这一次 —— 每行都非要带上自己的 submissionId 不可。
           ⚠️ 分隔线画在**每一行自己**的下边（同 pages/me/energy 的列表）：
              最后一行那条贴着卡片圆角，肉眼看不出来，不值得为它加一条 last: 规则。 -->
      <block wx:else>
        <view class="flex items-center justify-between px-3.5 py-3 border-b-[1rpx] border-b-solid border-b-line"
              hover-class="active__opacity-60"
              wx:for="{{historyRows}}" wx:key="submissionId"
              data-i="{{index}}" bindtap="onOpenHistory">
          <view class="flex items-center">
            <!-- ⭐ 听这一次的录音（用户 2026-09：第 N 次前面加一个播放按钮）。
                 ⚠️⚠️ 用**共用组件** recording-player，不在这里手写"取音 / 落盘 / 播 / 停"：
                    那套行为原来在「我的挑战」里已经有一份，再抄一份就是两处各自演化
                    （症状：同一个录音，一个列表里能播、另一个列表里点了没反应）。
                    组件内部自带三态与防连点，页面**不再需要** playing/loading 两个下标。
                 ⚠️ 录音地址按需向服务端要（每条单独授权、会过期）—— 这件事也在组件里。
                 ⚠️ 点它**不会**跳进详情：audio-button 自己 catchtap 拦住了冒泡。 -->
            <recording-player submissionId="{{item.submissionId}}" size="sm"
                              bind:error="onHistoryAudioError" />
            <text class="text-28rpx text-ink font-medium ml-2">第 {{item.seq}} 次</text>
            <!-- ⚠️ 「最高」标在**目前的最高分**那一行（并列时都标）——
                 它比一个数字更直接地回答"我最好那次是哪回"。 -->
            <text class="text-20rpx text-white bg-ok rounded-full px-2 py-[2rpx] ml-2"
                  wx:if="{{item.isBest}}">最高</text>
            <!-- ⚠️ 拿不到时间（老记录）时这一格**不渲染**，不画 Invalid Date —— 见 lib/time.ts -->
            <text class="text-22rpx text-faint ml-2" wx:if="{{item.ago}}">{{item.ago}}</text>
          </view>
          <view class="flex items-center shrink-0">
            <!-- ⚠️ 「未出分」（pending）用弱化样式，别和成绩一样粗黑体 ——
                 它不是一个分数（检测跑到了、但没读出有效语音），
                 抢眼会让人把它当成"这次考了多少"。 -->
            <text wx:if="{{item.pending}}" class="text-26rpx text-faint">{{item.scoreText}}</text>
            <text wx:else class="text-32rpx font-bold text-ink">{{item.scoreText}}</text>
            <!-- ⭐ 分数后面这颗 › =「点得进去」的提示（用户 2026-09 要求）。
                 ⚠️ 整行本来就 bindtap 进那一次的结果屏（见 onOpenHistory）——
                    没有它的时候这一行看起来只是一条只读记录，点了会跳是"猜"出来的。
                 ⚠️ 与「我的挑战」列表里那颗箭头是同一个图标（都走 <ui-icon name="mdi:chevron-right">）。 -->
            <ui-icon class="text-32rpx text-faint ml-1 leading-[1]" name="mdi:chevron-right" />
          </view>
        </view>
      </block>
    </view>

    <!-- ⚠️ 列表已经有内容、这次刷新却失败 → 一行细提示 + 重试，**保留**已有记录
         （同 pages/me/challenges：拉不到新的不该把已经看到的也抹掉）。 -->
    <view class="mt-2" wx:if="{{historyError && historyAttempts > 0}}">
      <text class="text-22rpx text-bad">{{historyError}}</text>
      <text class="text-22rpx text-brand ml-2" bindtap="onRetryHistory">重试</text>
    </view>
  </view>
</view>
