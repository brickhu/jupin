<!-- ⚠️ padding-top 由 navTop 给（= 导航栏总高 + 12），这里不要再写 pt-3 —— 见 lib/nav.ts -->
<view class="px-3 pb-[60rpx] bg-page min-h-[100vh] box-border" style="padding-top:{{navTop}}px">

  <!-- ⭐ 统一的自定义导航栏。left 不填 = auto：栈深度 ≥ 1 时画「返回」 -->
  <nav-bar id="nav" title="参与挑战" />

  <!-- ── 句子加载中 ────────────────────────────────────────── -->
  <view class="bg-white rounded-2.5 p-3.5 mb-3" wx:if="{{phase === 'loading' && !error}}">
    <text class="text-28rpx text-muted">正在加载句子…</text>
  </view>

  <!-- ── 句子加载失败 ──────────────────────────────────────── -->
  <view class="bg-white rounded-2.5 p-3.5 mb-3" wx:if="{{phase === 'loading' && error}}">
    <text class="text-28rpx text-bad block leading-[1.6]">{{error}}</text>
    <view class="mt-3">
      <ui-button variant="outline" color="default" width="full" bind:press="onReload">重试</ui-button>
    </view>
  </view>

  <!-- ══ 当前挑战卡：s1 / s2 / s3 共用同一张卡 ══════════════════
       （状态机与每一态的来龙去脉见 reading.ts 的文件头注释）
       ⚠️⚠️ 提交之后的三个态（上传中 / 评测中 / s5 / s6）**不在这张卡里** ——
          用户 2026-09 把它们整体搬进了 components/eval-dialog 的浮层：
          等待期天然禁止点击，结果也不再和句子挤在同一屏。 -->
  <view class="bg-white rounded-2.5 p-3.5 mb-3"
        wx:if="{{phase === 's1' || phase === 's2' || phase === 's3'}}">

    <!-- ── s1 / s3 顶行：标准音试听（▶ + 时长）｜IPA 开关 ────── -->
    <view class="flex items-center justify-between mb-3" wx:if="{{phase === 's1' || phase === 's3'}}">
      <view class="flex items-center">
        <!-- ⚠️ 只在这一句真的灌了标准音时才渲染这颗钮（canPlayAudio）：
             点了没反应的图标比没有这个按钮更难排查。
             ⚠️ 用 ui-button 的 ghost/default（浅灰实心圆 + 深色字形）而不是 audio-button：
                设计稿上这颗是「实心浅灰圆」，而 audio-button 的未播放态是**描边**。 -->
        <!-- ⚠️⚠️ 这里**故意不传 loading**，改用 icon 表达"在取音"：
             ui-button 的 loading 会**吞掉点击**（防重复提交用的），而这颗是**开关** ——
             一旦某次取音卡住，那颗钮就永远点不动了（界面上只看到转圈，
             连"再点一次重试"都做不到）。用户 2026-09 报的"播放按钮不能播放"就是这个形状。
             ⇒ 取音中显示 mdi:loading 字形，点击照常进来（再点 = 重试，见 onPlaySentence）。 -->
        <ui-button wx:if="{{canPlayAudio}}" onlyIcon="{{true}}" size="md" variant="ghost" color="default"
                   icon="{{sentenceState === 'loading' ? 'mdi:loading' : sentenceState === 'playing' ? 'mdi:stop' : 'mdi:play'}}"
                   bind:press="onPlaySentence" />
        <!-- ⚠️ 时长拿不到就**不渲染**这几个字（不是显示 00:00 —— 那看着像音频坏了）。
             详情接口目前没有这个数，见 reading.ts 的 stdDurationText -->
        <text class="text-28rpx text-body ml-2" wx:if="{{stdDurationText}}">{{stdDurationText}}</text>
      </view>
      <!-- ⭐ IPA 胶囊 = 切换「单词下方显示音标」；开着时变实心，状态一眼可见 -->
      <ui-button size="sm" variant="{{ipaOn ? 'fill' : 'ghost'}}" color="{{ipaOn ? 'brand' : 'default'}}"
                 bind:press="onToggleIpa">IPA</ui-button>
    </view>

    <!-- ── s2 顶行：红点 + 录音中…｜右侧红色计时器 ───────────── -->
    <!-- -- 给改代码的人 --
         min-h-[76rpx] 是**故意的**：s1/s3 那一行里放着 ui-button size="md"
         （= 76rpx 高的圆钮 / IPA 胶囊），而这一行只有一个小红点和几个字 ——
         不撑高的话，s1 → s2 那一下整张卡的内容会**往上跳**
         （用户 2026-09 报的「s2 顶栏和 s1 高度不一致」）。
         76 与 ub-s-md 是同一个数，改按钮尺寸时一起改。 -->
    <view class="flex items-center justify-between mb-3 min-h-[76rpx]" wx:if="{{phase === 's2'}}">
      <view class="flex items-center">
        <view class="w-[20rpx] h-[20rpx] rounded-full bg-bad shrink-0"></view>
        <text class="text-28rpx text-body ml-2">录音中...</text>
      </view>
      <!-- -- 给改代码的人 --
           时间在 TS 里格式化（见 mmss）：WXML 不做任何计算。
           字号取 32rpx：s1/s3 那一行右边是 ub-s-md 的 IPA 胶囊（28rpx），
           而这是一个**正在走的计时器** —— 比胶囊里的静态标签再重一档才读得清。 -->
      <text class="text-32rpx text-bad">{{elapsedText}}</text>
    </view>

    <!-- ── s1 / s2 / s3 主体：句子（逐词渲染）────────────────────
         ⚠️ 逐词是为了「点词听发音」和「词下挂音标」两件事，下标与正文 words[] 一一对应。
         ⚠️ s2 录音中不显示音标（设计稿口径）：录音时少一层干扰。 -->
    <view class="flex flex-wrap" wx:if="{{phase === 's1' || phase === 's2' || phase === 's3'}}">
      <!-- ⚠️ data-i 带的是**下标**而不是词本身：同一句里 "the" 会出现两次，
           按文本找必然指错那一个（见 reading.ts 的 onPlayWord）。 -->
      <view class="flex flex-col items-center mr-2 mb-1" wx:for="{{words}}" wx:key="i"
            data-i="{{item.i}}" bindtap="onPlayWord">
        <!-- ⚠️ px-1 mr-1 的写法与迁移前一致：高亮底色的内边距不跟着 cls 走，着色时整行不抖 -->
        <text class="text-44rpx leading-[1.35] text-ink px-1 {{playingWord === item.i ? 'bg-brand_10 rounded-1' : ''}}">{{item.text}}</text>
        <!-- ⚠️ 没有音标（老正文 / 查不到）时这一行不渲染，不占位 -->
        <text class="text-20rpx leading-[1.4] text-faint" wx:if="{{ipaOn && phase !== 's2' && item.ipa}}">{{item.ipa}}</text>
      </view>
    </view>

    <!-- ⚠️ 译文**不放**（用户 2026-09 明确：阅读卡片不用显示翻译）。
         朗读练习看中文是上一版的旧口径，已作废 —— 别看着"空了一块"又加回来。 -->

    <!-- ── s1 底部：红色描边胶囊「🎤 点击录音并朗读」─────────────
         ⚠️ 红色是设计稿口径（录音这个动作走语义色，不是品牌紫）。
         ⚠️ 左侧那颗麦克风字形是 2026-09 补进 iconfont 子集的（第 13 个字形，
            见 tools/iconfont/build.mjs 的 ICONS）—— 之前没有它，只留了文字。 -->
    <view class="mt-5" wx:if="{{phase === 's1'}}">
      <ui-button variant="outline" color="error" size="xl" width="full"
                 icon="mdi:microphone" bind:press="onStartRecord">点击录音并朗读</ui-button>
    </view>

    <!-- ── s2 底部：↺（禁用占位）｜实时波形｜结束录音 ─────────────
         ⚠️ 三态里的圆钮**一律 size="xl"**（= 100rpx）：s2 的结束录音、s3 的 ↺ / ✓、
            s1 的 CTA 都是这一档。它们在同一张卡里、同一个位置、隔一帧就换 ——
            尺寸不一致（88 vs 100rpx）在切换时会明显"跳一下"。
            ⚠️ 中间那颗胶囊是 **md**：它是 UI 模板宽度的一段内容，不是圆钮，
              行高由 xl 的圆钮撑开，它自己居中即可。 -->
    <view class="mt-5 flex items-center" wx:if="{{phase === 's2'}}">
      <!-- ⚠️ 录音中这颗 ↺ 是**禁用的**（用户已确认：录音中不给重录，只作占位）。
           ⚠️ ↺ 用的是 unicode 字符：iconfont 子集里没有重录字形（见 ui-button 的说明） -->
      <ui-button onlyIcon="{{true}}" size="xl" variant="ghost" color="default" disabled="{{true}}">
        <text class="text-36rpx text-ink">↺</text>
      </ui-button>

      <view class="flex-1 min-w-0 mx-3">
        <!-- ⭐ 声波监测：以中线对称的实心柱条，一帧画一次（见 reading.ts 的 drawSamples）。
             ⚠️ 它回答的是**用户唯一能自查的问题**：「麦克风到底收到我的声音没有」。
                没有它，用户只能靠"读完了分数很低"倒推，而那时已经晚了。
             ⚠️ 用 canvas 而不是一排 <view>：一帧 1024 个采样点，节点方案既扛不住也会糊成一块。
             ⚠️ 尺寸必须由 CSS 给（canvas 默认 300×150），backing store 在 JS 里按 dpr 开。 -->
        <canvas type="2d" id="wave" class="w-full h-[64rpx]" wx:if="{{waveOn}}"></canvas>
        <!-- ⚠️⚠️ 画不画由 waveOn 决定，而它取决于**这一轮真的收到了能解码的帧没有**
             （开发者工具的 WebAudio 解不开 mp3 码流，那里恒为 false）。
             这时只留一条中线 —— 绝不摆一条不动的假波形：那比没有更糟，
             会让人以为是自己手机 / 麦克风的问题（这是踩过的坑）。 -->
        <view class="h-[64rpx] flex items-center" wx:else>
          <view class="w-full h-[4rpx] rounded-full bg-line"></view>
        </view>
      </view>

      <!-- ⚠️ 红色实心圆里的方块：设计稿是**黑方块**，不是白色 stop 字形 -->
      <ui-button onlyIcon="{{true}}" size="xl" variant="fill" color="error" bind:press="onStopRecord">
        <view class="w-[28rpx] h-[28rpx] rounded-[4rpx] bg-ink"></view>
      </ui-button>
    </view>

    <!-- ── s3 底部：↺ 重录｜试听我的录音｜绿色 ✓（确认 = 提交评测）── -->
    <view class="mt-5" wx:if="{{phase === 's3'}}">
      <view class="flex items-center">
        <ui-button onlyIcon="{{true}}" size="xl" variant="ghost" color="default" bind:press="onRestart">
          <text class="text-36rpx text-ink">↺</text>
        </ui-button>

        <!-- ⚠️ 这颗是 outline 胶囊（设计稿口径），所以用 ui-button 而不是 audio-button：
             audio-button 只有圆钮。图标走 iconify 名（mdi:play / mdi:stop） -->
        <view class="flex-1 min-w-0 mx-3">
          <ui-button variant="outline" color="default" size="md" width="full"
                     loading="{{replayState === 'loading'}}"
                     icon="{{replayState === 'playing' ? 'mdi:stop' : 'mdi:play'}}"
                     bind:press="onReplay">{{recordDurationText}}</ui-button>
        </view>

        <ui-button onlyIcon="{{true}}" size="xl" variant="fill" color="success" bind:press="onSubmit">
          <text class="text-36rpx text-ink">✓</text>
        </ui-button>
      </view>

      <!-- ⚠️ 这一态**不再显示**「评测消耗能量2，剩余3」（用户 2026-09 定：删掉）。
           能量那件事挪到**提交那一步的确认弹窗**里说（显示「本次消耗 N 点，确认后剩 M 点」），
           而且那时数字是**服务端权威余额**，比这里拿缓存估的准。
           ⇒ 别看着这块"少了一行"又加回来。 -->
    </view>

  </view>

  <!-- ══ 评测弹窗 ══════════════════════════════════════════════
       ⚠️⚠️ 提交评测之后的三个态（上传中 / 评测中 / 出分 s5 / 失败 s6）**都在这一层里**
          （用户 2026-09 定）：等待期禁止点击由遮罩天然保证，结果也不和句子挤在同一屏。
       ⚠️ 它自己判断画不画（看 mode + phase），这里不需要 wx:if。
       ⚠️ 两块各由谁来决定：
          · mode=precheck（提交前确认能量）—— confirmOpen 说了算，
            用 phase='precheck' 表示"正在问权威余额"；
          · mode=submitting（评测过程与结果）—— 原来的 s4/s5/s6。
       ⚠️ 四个回调都由本页实现：onConfirmResult（关窗 + 回 s1 + 这一次进历史）/
          onOpenDetail（navigateTo pages/challenge）/ onConfirmStart（真的开始提交）/
          onConfirmCancel（取消，什么都没发生）/ onConfirmGoEnergy（去能量页）。 -->
  <eval-dialog mode="{{confirmOpen ? 'precheck' : 'submitting'}}"
               phase="{{phase}}" uploadPercent="{{uploadPercent}}"
               scoreText="{{scoreText}}" scoreSubtitle="{{scoreSubtitle}}"
               attemptTitle="{{attemptTitle}}" growthCards="{{growthCards}}"
               failDetail="{{failDetail}}" energyNote="{{energyNote}}"
               costEnergy="{{costEnergy}}" balanceEnergy="{{confirmEnergy}}"
               bind:confirm="onConfirmResult" bind:openDetail="onOpenDetail"
               bind:start="onConfirmStart" bind:cancel="onConfirmCancel"
               bind:goEnergy="onConfirmGoEnergy" />

  <!-- ── 通用错误条（横跨六态，不改变状态）─────────────────────
       ⚠️ 麦克风没授权、能量不够、上传失败、轮询断网……都在这里说一句人话。
          s6 那句「录音不符合规范」不走这里 —— 它是 s6 的正文。
       ⚠️ 句子还没拉到时的错误已经在上面那张卡里了，别重复显示。 -->
  <view class="mb-3 bg-red-50 border-l-[6rpx] border-solid border-bad rounded-1 p-2.5"
        wx:if="{{error && phase !== 'loading'}}">
    <text class="text-24rpx text-red-800 leading-[1.6]">{{error}}</text>
  </view>

  <!-- ══ 下方「历史挑战」——我在**这一句**上还读过哪几次 ═══════════
       ⚠️ 与「我的挑战」列表（pages/me/challenges）不是一回事：那边一行还要显示句子本身，
          而这一页的句子就在上面 —— 一行只留三件事：第几次 · 什么时候 · 多少分。
       ⚠️ 列表里**不含当前这一次**（口径与实现见 lib/article-history.ts）。
       ⚠️ 只在句子已经拉到时才画这一块：句子都没有的时候，这一页的主体现在是
          「正在加载句子…」/「重试」，下面再挂一段历史会喧宾夺主。 -->
  <view class="mt-3" wx:if="{{phase !== 'loading'}}">
    <!-- ⚠️ 表头只剩分组名（用户 2026-09）：原来右边还有一句「共 N 次 · 最高 X」——
         那个数现在由**下面的「我的参与」摘要卡**说（而且那张说的是"含当前这一把"的全部，
         与历史行的口径不同，见 lib/article-history.ts）。同一件事不摆两处。 -->
    <view class="flex items-baseline justify-between px-1 mb-2">
      <text class="text-26rpx text-muted">历史挑战</text>
    </view>

    <!-- ══ 我的参与（摘要卡）——用户 2026-09：做成 pages/me/participations 那样的卡片 ══
         ⚠️ 四个数与「我的挑战」列表同一套：**挑战 / 最高 / 位列 / 最低**，
            上标签下数字、四等分（那页就是这两行结构，别在这儿改成别的排法）。
         ⚠️⚠️ 它与下面「历史挑战」的行**口径不同**：这张卡说的是"我在这一句上的全部"
            （含当前这一把），行那一列免掉"当前这一次" —— 见 lib/article-history.ts 的说明。
         ⚠️ 只在真的拿到过数据时画（historyReady）：否则会先闪一张全是「—」的卡。 -->
    <view class="bg-white rounded-2.5 p-4 mb-3" wx:if="{{historyReady}}">
      <view class="flex">
        <view class="flex-1">
          <text class="text-22rpx text-faint block">挑战</text>
          <text class="text-30rpx font-semibold text-ink">{{summary.attemptsText}}</text>
        </view>
        <view class="flex-1">
          <text class="text-22rpx text-faint block">最高</text>
          <text class="text-34rpx font-bold text-brand">{{summary.bestScoreText}}</text>
        </view>
        <view class="flex-1">
          <text class="text-22rpx text-faint block">位列</text>
          <text class="text-30rpx font-semibold text-ink">{{summary.rankText}}</text>
        </view>
        <view class="flex-1">
          <text class="text-22rpx text-faint block">最低</text>
          <text class="text-30rpx font-semibold text-muted">{{summary.lowestScoreText}}</text>
        </view>
      </view>
    </view>

    <view class="bg-white rounded-2.5">
      <!-- ── 正在取（首次进入）────────────────────────────────── -->
      <view class="p-5" wx:if="{{historyLoading}}">
        <text class="text-28rpx text-muted">正在取历史记录…</text>
      </view>

      <!-- ── 一条都没有 ────────────────────────────────────────
           ⚠️ 它和「正在取」是两件事：空列表配「正在取…」会让人一直等下去（同我的挑战列表）。
           ⚠️ 这条分支只有**真的读到了零条**才算数 —— 拉失败时进下面那条
              "取不到"，不能报「这句上还没有别的记录」（那是句假话）。 -->
      <view class="px-5 py-8 text-center" wx:elif="{{historyAttempts === 0 && !historyError}}">
        <text class="text-26rpx text-faint leading-[1.6]">这句上还没有别的记录 —— 再读一次，这里就会有第二条。</text>
      </view>

      <!-- ── 取不到（且一条都没拿到）→ 一句话 + 重试 ───────────── -->
      <view class="p-5" wx:elif="{{historyAttempts === 0}}">
        <text class="text-28rpx text-bad leading-[1.6]">{{historyError}}</text>
        <view class="flex justify-end mt-2">
          <text class="text-26rpx text-brand" bindtap="onRetryHistory">重试</text>
        </view>
      </view>

      <!-- ── 一行 = 我在这一句上的一次挑战 ──────────────────────
           ⚠️ 点进去看的是**那一次**的结果屏（pages/challenge?sid=…），
              不是当前这一次 —— 每行都非要带上自己的 submissionId 不可。
           ⚠️ 分隔线画在**每一行自己**的下边（同 pages/me/energy 的列表）：
              最后一行那条贴着卡片圆角，肉眼看不出来，不值得为它加一条 last: 规则。 -->
      <block wx:else>
        <view class="flex items-center justify-between px-3.5 py-3 border-b-[1rpx] border-b-solid border-b-line"
              hover-class="active__opacity-60"
              wx:for="{{historyRows}}" wx:key="submissionId"
              data-i="{{index}}" bindtap="onOpenHistory">
          <view class="flex items-center">
            <!-- ⭐ 听这一次的录音（用户 2026-09：第 N 次前面加一个播放按钮）。
                 ⚠️⚠️ 用**共用组件** recording-player，不在这里手写"取音 / 落盘 / 播 / 停"：
                    那套行为原来在「我的挑战」里已经有一份，再抄一份就是两处各自演化
                    （症状：同一个录音，一个列表里能播、另一个列表里点了没反应）。
                    组件内部自带三态与防连点，页面**不再需要** playing/loading 两个下标。
                 ⚠️ 录音地址按需向服务端要（每条单独授权、会过期）—— 这件事也在组件里。
                 ⚠️ 点它**不会**跳进详情：audio-button 自己 catchtap 拦住了冒泡。 -->
            <recording-player submissionId="{{item.submissionId}}" size="sm"
                              bind:error="onHistoryAudioError" />
            <text class="text-28rpx text-ink font-medium ml-2">第 {{item.seq}} 次</text>
            <!-- ⚠️ 「最高」标在**目前的最高分**那一行（并列时都标）——
                 它比一个数字更直接地回答"我最好那次是哪回"。 -->
            <text class="text-20rpx text-white bg-ok rounded-full px-2 py-[2rpx] ml-2"
                  wx:if="{{item.isBest}}">最高</text>
            <!-- ⚠️ 拿不到时间（老记录）时这一格**不渲染**，不画 Invalid Date —— 见 lib/time.ts -->
            <text class="text-22rpx text-faint ml-2" wx:if="{{item.ago}}">{{item.ago}}</text>
          </view>
          <text class="text-32rpx font-bold text-ink shrink-0">{{item.scoreText}}</text>
        </view>
      </block>
    </view>

    <!-- ⚠️ 列表已经有内容、这次刷新却失败 → 一行细提示 + 重试，**保留**已有记录
         （同 pages/me/challenges：拉不到新的不该把已经看到的也抹掉）。 -->
    <view class="mt-2" wx:if="{{historyError && historyAttempts > 0}}">
      <text class="text-22rpx text-bad">{{historyError}}</text>
      <text class="text-22rpx text-brand ml-2" bindtap="onRetryHistory">重试</text>
    </view>
  </view>
</view>
