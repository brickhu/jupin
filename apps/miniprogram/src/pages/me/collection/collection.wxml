<!--
  ⭐ 「我的收藏」—— 我收过的句子，最近收的排前面。

  ⚠️ 一张卡 = 一句话（收藏与「读没读过」无关）。
  ⚠️ 整张卡可点 → 竞技场；右下角那个按钮是「取消收藏」——
      它是 ui-button（统一按钮），事件名是 **press**（见那个组件）。
-->
<view class="px-3 pb-[60rpx] bg-page min-h-[100vh] box-border" style="padding-top:{{navTop}}px">

  <nav-bar id="nav" title="我的收藏" />

  <!-- ── 加载中 ────────────────────────────────────────────── -->
  <view class="bg-white rounded-2.5 p-5" wx:if="{{loading}}">
    <text class="text-28rpx text-muted">正在取收藏…</text>
  </view>

  <!-- ── 连不上（且一条都还没有）───────────────────────────── -->
  <view class="bg-white rounded-2.5 p-5" wx:elif="{{error && rows.length === 0}}">
    <text class="text-28rpx text-bad block leading-[1.6]">{{error}}</text>
    <view class="mt-3">
      <ui-button size="sm" width="full" bind:press="onRetry">重试</ui-button>
    </view>
  </view>

  <!-- ── 一句都没收 ────────────────────────────────────────── -->
  <view class="bg-white rounded-2.5 px-5 py-10 text-center" wx:elif="{{empty}}">
    <text class="text-56rpx block">❤</text>
    <text class="text-30rpx text-ink font-medium block mt-3">还没有收藏</text>
  </view>

  <block wx:else>
    <!-- ⚠️ 有内容、但这次刷新失败：一行细提示 + 重试，保留已有记录 -->
    <view class="bg-red-50 border-l-[6rpx] border-solid border-bad rounded-1 p-2.5 mb-2.5" wx:if="{{error}}">
      <text class="text-24rpx text-red-800 leading-[1.6]">{{error}}</text>
    </view>

    <view class="bg-white rounded-2.5 p-4 mb-3" wx:for="{{rows}}" wx:key="articleId"
          data-i="{{index}}" bindtap="onOpen">

      <!-- 难度 + 标签（都没有就整行不渲染，不留空行） -->
      <view class="flex items-center mb-2" wx:if="{{item.levelText || item.tagsText}}">
        <text class="text-22rpx text-brand border border-solid border-brand rounded-1 px-1.5 py-[2rpx] mr-2" wx:if="{{item.levelText}}">{{item.levelText}}</text>
        <text class="text-22rpx text-faint">{{item.tagsText}}</text>
      </view>

      <text class="text-32rpx leading-[1.5] text-ink block">{{item.text}}</text>

      <!-- 底部：左「收藏时间 + 我的战绩」，右「取消收藏」 -->
      <view class="flex items-end mt-3 pt-3 border-t-[1rpx] border-t-solid border-t-line">
        <view class="flex-1">
          <text class="text-22rpx text-faint block">{{item.favoritedText}}</text>
          <text class="text-24rpx text-muted block mt-1">{{item.mineText}}</text>
        </view>
        <!-- ⚠️ catchtap 兜一道：按钮的 press 已经由 ui-button 截住，这里再防一层冒泡到卡片 -->
        <view catchtap="noop">
          <ui-button size="sm" variant="ghost" color="error" data-i="{{index}}" bind:press="onRemove">取消收藏</ui-button>
        </view>
      </view>
    </view>
  </block>
</view>
