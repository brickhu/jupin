<!--
  ⭐ 「连战记录」—— 一个月的日历：哪天读了。
       ⚠️ 原来还有第二种格子（"用解冻卡补的"）—— 解冻卡 2026-10 整体作废，那种格子没了。

  ⚠️ 两块自上而下：统计 → 日历。
     顺序是「我走到哪了 → 怎么走到这的 → 还有什么没拿」，别调。
  ⚠️ 日历排版要的三个数全来自服务端（见 streak.ts 的说明），这里只负责画。
-->
<view class="px-3 pb-[60rpx] bg-page min-h-[100vh] box-border" style="padding-top:{{navTop}}px">

  <!-- ⭐ 启动遮罩：身份解析完成前整页盖住（见 components/boot-overlay） -->
  <boot-overlay />
  <nav-bar id="nav" title="连战记录" />

  <!-- ── ① 统计 ─────────────────────────────────────────────── -->
  <view class="card p-5 flex items-center">
    <view class="flex-1">
      <text class="text-72rpx font-bold text-ink leading-[1]">{{streakDays}}</text>
      <text class="text-24rpx text-faint block mt-2">连续战斗</text>
      <text class="text-22rpx text-faint block mt-1">历史最长 {{streakBest}} 天</text>
    </view>
    <text class="text-120rpx leading-[1]">🔥</text>
  </view>

  <!-- ── ② 连战日历 ─────────────────────────────────────────── -->
  <view class="card p-4 mt-3">
    <view class="flex items-center">
      <view class="px-3 py-2" bindtap="onPrev" hover-class="active__opacity-60">
        <ui-icon class="text-40rpx text-muted" name="mdi:chevron-left" />
      </view>
      <text class="flex-1 text-center text-28rpx font-medium text-ink">{{monthText}}</text>
      <view class="px-3 py-2 {{canNext ? '' : 'opacity-30'}}" bindtap="onNext" hover-class="{{canNext ? 'active__opacity-60' : ''}}">
        <ui-icon class="text-40rpx text-muted" name="mdi:chevron-right" />
      </view>
    </view>

    <!-- 星期表头 -->
    <view class="flex mt-2">
      <text class="text-22rpx text-faint text-center" style="width:14.28%">日</text>
      <text class="text-22rpx text-faint text-center" style="width:14.28%">一</text>
      <text class="text-22rpx text-faint text-center" style="width:14.28%">二</text>
      <text class="text-22rpx text-faint text-center" style="width:14.28%">三</text>
      <text class="text-22rpx text-faint text-center" style="width:14.28%">四</text>
      <text class="text-22rpx text-faint text-center" style="width:14.28%">五</text>
      <text class="text-22rpx text-faint text-center" style="width:14.28%">六</text>
    </view>

    <!-- 格子：7 列自动换行。⚠️ 类是拼出来的，见 wxss 里的说明 -->
    <view class="flex flex-wrap mt-1">
      <view class="streak-cell" wx:for="{{cells}}" wx:key="key">
        <view class="streak-day {{item.kind === 'read' ? 'streak-day-read' : ''}} {{item.isToday ? 'streak-day-today' : ''}}">
          <text class="text-24rpx">{{item.day}}</text>
        </view>
      </view>
    </view>

    <!-- 图例 —— ⚠️ 色块用 streak.wxss 里的类，不是 uno 工具类：
         日历的黄/蓝是这一页专有的，uno theme 里没有这两个色板（见 wxss 顶部说明） -->
    <view class="flex items-center mt-3 pt-3 border-t-[1rpx] border-t-solid border-t-line">
      <view class="streak-swatch streak-swatch-read"></view>
      <text class="text-22rpx text-faint ml-2">连战</text>
    </view>
  </view>

  <!-- ── 连不上 ────────────────────────────────────────────── -->
  <view class="bg-red-50 border-l-[6rpx] border-solid border-bad rounded-1 p-2.5 mt-3" wx:if="{{error}}">
    <text class="text-24rpx text-bad leading-[1.6]">{{error}}</text>
    <text class="text-24rpx text-brand ml-2" bindtap="onRetry">重试</text>
  </view>
</view>
