<!--
  ⭐ 「能量」—— 余额 → 充值 → 流水。

  ⚠️ 顺序是「我有什么 → 怎么变多 → 怎么花掉的」，别调：
     一屏上来就摆价格，用户第一反应是「我又要花钱了」。
  ⚠️ 价格全部来自服务端（/api/shop/goods），这一页一个字都不写死。
-->
<view class="px-3 pb-[60rpx] bg-page min-h-[100vh] box-border" style="padding-top:{{navTop}}px">

  <!-- ⭐ 启动遮罩：身份解析完成前整页盖住（见 components/boot-overlay） -->
  <boot-overlay />
  <nav-bar id="nav" title="能量" />

  <!-- ⚠️ 沙箱环境要在页面上**说出来**：测试期最容易犯的错觉是「我在花钱」。 -->
  <view class="energy-sandbox rounded-1 px-3 py-2 mb-3" wx:if="{{payEnv === 1}}">
    <text class="text-22rpx text-warn">当前是沙箱环境（测试）—— 不会真扣钱，道具也未必真发货</text>
  </view>

  <!-- ── ① 余额 ───────────────────────────────────────────── -->
  <view class="card p-5 flex items-center">
    <view class="flex-1">
      <view class="flex items-baseline">
        <text class="text-72rpx font-bold text-ink leading-[1]">{{energy}}</text>
        <text class="text-24rpx text-faint ml-2">点</text>
      </view>
      <!-- ⚠️ 两个数都由服务端给（perChallenge / dailyFloor），端侧不写死 2 和 3 -->
      <text class="text-22rpx text-faint block mt-3">每次挑战消耗 {{perChallenge}} 点</text>
      <text class="text-22rpx text-faint block mt-1">每天补到 {{dailyFloor}} 点（用不完不会清零）</text>
    </view>
    <text class="text-120rpx leading-[1]">⚡</text>
  </view>

        <!-- ── ①.⑤ 吃饼干换能量 ─────────────────────────────────────
       ⭐ 放在**余额下面、充值上面**：它和充值回答的是同一个问题
          （"我怎么把能量变多"），而这是不花钱的那条路。
       ⚠️ 一次换完（服务端不接受数量）：能量比饼干更通用 —— 能读句子、
          也能补签，而饼干只有这一个用途，留着它没有任何好处。
       ⚠️ 余额不足 40 时按钮置灰，不让他点了才发现。 -->
  <view class="card p-4 mt-3">
    <view class="flex items-center">
      <text class="text-32rpx">🍪</text>
      <view class="flex-1 ml-2">
        <text class="text-28rpx text-ink font-medium">吃饼干补充能量</text>
        <text class="text-22rpx text-faint block mt-0.5">{{cookiesPerEnergy}} 块 🍪 = 1 点能量</text>
      </view>
      <text class="text-32rpx font-bold text-ink">{{cookieBalance}}</text>
    </view>

    <view class="mt-3 text-center py-[22rpx] rounded-full text-28rpx font-medium {{cookieEnergy > 0 && !exchanging ? 'bg-brand text-white' : 'bg-line text-faint'}}"
          bindtap="onExchange" hover-class="{{cookieEnergy > 0 ? 'active__opacity-60' : ''}}">
      <block wx:if="{{exchanging}}">兑换中…</block>
      <block wx:elif="{{cookieEnergy > 0}}">换 {{cookieEnergy}} 点能量</block>
      <block wx:else>再攒攒（还差 {{cookiesPerEnergy - cookieBalance}} 块）</block>
    </view>

    <text class="text-22rpx text-faint block mt-2 text-center">一次换完 —— 能量既能读句子、也能补签，比饼干更经用</text>
  </view>

  <!-- ── ①.⑥ 看视频补能量 ─────────────────────────────────────
     ⭐ 与饼干卡同一个位置逻辑（不花钱的那条路），但**更快**：一条视频 = 1 点，
        而饼干要攒 40 块 —— 所以排在饼干之后、充值之前。
     ⚠️⚠️ 文案与"承诺几点"全部来自 shared 常量：官方把
        「播放后未下发所承诺的奖励」列为二级违规，承诺与实发必须同源。
     ⚠️ 入口**不按付费/免费分流**：流量主规范明禁「设计广告的关闭逻辑，包括付费免广告」。 -->
  <view class="card p-4 mt-3">
    <view class="flex items-center">
      <text class="text-32rpx">📺</text>
      <view class="flex-1 ml-2">
        <text class="text-28rpx text-ink font-medium">看视频补能量</text>
        <text class="text-22rpx text-faint block mt-0.5">{{adNote}}</text>
      </view>
    </view>

    <view class="mt-3 text-center py-[22rpx] rounded-full text-28rpx font-medium {{adRewarding ? 'bg-line text-faint' : 'bg-brand text-white'}}"
          bindtap="onAdReward" hover-class="{{adRewarding ? '' : 'active__opacity-60'}}">
      <block wx:if="{{adRewarding}}">播放中…</block>
      <block wx:else>看视频，补 {{adPoints}} 点</block>
    </view>

    <text class="text-22rpx text-faint block mt-2 text-center">每天能看几次由微信广告系统决定 —— 没有广告可放时会提示你稍后再试</text>
  </view>

  <!-- ── ② 充值 ───────────────────────────────────────────── -->
  <view class="card p-4 mt-3">
    <text class="text-28rpx font-medium text-ink">充值</text>

    <view class="mt-3" wx:for="{{goods}}" wx:key="code">
      <!-- ⚠️ 买不了的两件事要分开说：下架 vs 还没配好道具。文案都用服务端那句「暂时买不了」 -->
      <view class="flex items-center py-3 border-b-[1rpx] border-b-solid border-b-line {{item.sellable ? '' : 'opacity-40'}}"
            data-code="{{item.code}}" bindtap="onBuy"
            hover-class="{{item.sellable ? 'active__opacity-60' : ''}}">

  <!-- ⚠️ 图是**可选**的：认不出来的商品码就没有 image，这里就不渲染 -->
        <image class="energy-thumb" src="{{item.image}}" mode="aspectFill" wx:if="{{item.image}}" />
        <view class="flex-1">
          <view class="flex items-center">
            <text class="text-32rpx font-medium text-ink">{{item.title}}</text>
            <text class="text-20rpx text-white bg-warn rounded-full px-2 py-[2rpx] ml-2" wx:if="{{item.badge}}">{{item.badge}}</text>
          </view>
          <text class="text-22rpx text-faint block mt-1">{{item.subtitle}} · {{item.unitText}}</text>
        </view>
        <text class="text-30rpx font-semibold text-brand ml-3">{{item.priceText}}</text>
        <text class="text-24rpx text-faint ml-2" wx:if="{{paying && payingCode === item.code}}">…</text>
      </view>
    </view>

  </view>

  <!-- ── ③ 流水 ───────────────────────────────────────────── -->
  <view class="card p-4 mt-3">
    <text class="text-28rpx font-medium text-ink">能量流水</text>

    <view class="flex items-center py-3 border-b-[1rpx] border-b-solid border-b-line" wx:for="{{rows}}" wx:key="id">
      <view class="flex-1">
        <text class="text-26rpx text-ink block">{{item.label}}</text>
        <text class="text-20rpx text-faint block mt-[2rpx]">{{item.timeText}}</text>
      </view>
      <!-- ⚠️ 入账用品牌色、出账用灰：一眼能扫出「哪几笔是花钱的」 -->
      <text class="text-28rpx font-medium {{item.income ? 'text-brand' : 'text-muted'}}">{{item.deltaText}}</text>
    </view>

    <view class="text-center py-3" wx:if="{{hasMore}}" bindtap="onMore" hover-class="active__opacity-60">
      <text class="text-24rpx text-brand">{{loadingMore ? '加载中…' : '看更早的'}}</text>
    </view>
    <text class="text-22rpx text-faint block text-center py-3" wx:elif="{{rows.length === 0 && !loading}}">还没有任何记录</text>
  </view>

  <!-- ── 连不上 ────────────────────────────────────────────── -->
  <view class="bg-red-50 border-l-[6rpx] border-solid border-bad rounded-1 p-2.5 mt-3" wx:if="{{error}}">
    <text class="text-24rpx text-bad leading-[1.6]">{{error}}</text>
    <text class="text-24rpx text-brand ml-2" bindtap="onRetry">重试</text>
  </view>
</view>
