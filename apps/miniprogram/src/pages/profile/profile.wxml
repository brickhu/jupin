<!--
  ⭐ 「个人主页」—— 按**用户 id** 取一份数据，一页一套渲染。

  ⚠️⚠️ 没有「本人视角 / 访客视角」之分：?u=<id> 就是这一页的地址，
     转发出去谁打开看到的都是同一个人的主页（包括我自己那份）。
       · 带 ?u=<id> → 看那一份
       · 不带       → 看自己的（id 从 store 的 profile 里取）
  ⚠️ 三个成长值**分开展示、不合成总分** —— 每个数各自回答一个问题，
     相加之后没人解释得清那个数是怎么来的。
  ⚠️ 这里**不放**「连战记录 / 参与场次 / 我的挑战」入口：
     那是**看的人的私有列表**，而这一页是给所有人看的（入口在用户面板菜单里）。
-->
<view class="px-3 pb-[60rpx] bg-page min-h-[100vh] box-border" style="padding-top:{{navTop}}px">

  <nav-bar id="nav" title="朗读挑战者" />

  <!-- ── 正在取 / 取不到 ────────────────────────────────────────
       ⚠️ 「取不到」只有两种：id 不存在（链接失效 / 账号被关 —— 服务端一律 404）
          与网络失败。**还没有我的 id** 不是错误，见下面的「加入」。 -->
  <view class="bg-white rounded-2.5 p-5" wx:if="{{loading}}">
    <text class="text-28rpx text-muted">正在取主页…</text>
  </view>
  <view class="bg-white rounded-2.5 p-5" wx:elif="{{error}}">
    <text class="text-28rpx text-bad block leading-[1.6]">{{error}}</text>
  </view>

  <block wx:else>
    <!-- ── 头部：头像 / 「加入」 + 昵称 + 能量 ────────────────────
         ⚠️ 昵称下面那行与**用户面板**逐字一致（⚡ 能量 N 点 › · ❄️ 解冻卡 M 张），
            它是**只有本人能看到的模块**：服务端对别人的主页不给这两项（见 share.ts）。
         ⚠️ 还没有我的 id（= 还没加入）时这一格画「加入」按钮：
            没有账号就没有主页可看，而「未设置昵称 / 能量 0 点」都是**有账号**的口吻。
         ⚠️ 两种形态尺寸一样（112rpx），换形态时布局不跳。 -->
    <view class="bg-white rounded-2.5 p-4 flex items-center">
      <view class="pr-join" wx:if="{{!hasProfile}}" bindtap="onJoin"
            hover-class="active__opacity-60">加入</view>
      <image wx:else class="w-[112rpx] h-[112rpx] rounded-full bg-line" src="{{avatarSrc || avatarPlaceholder}}" mode="aspectFill" />
      <view class="ml-3 flex-1">
        <text class="text-34rpx font-semibold text-ink block">{{nickname}}</text>
        <text class="text-24rpx text-faint block mt-1" wx:if="{{hasEnergy}}" bindtap="onEnergy"
              hover-class="active__opacity-60">⚡ 能量 {{energy}} 点 › · ❄️ 解冻卡 {{unfreezeCards}} 张</text>
      </view>
      <!-- ⭐ 分享按钮必须是 button[open-type=share]：小程序里只有它能主动拉起转发 -->
      <button class="pr-share shrink-0" open-type="share" wx:if="{{hasProfile}}">
        <text class="text-32rpx iconfont icon-share"></text>
      </button>
    </view>

    <!-- ── 成绩：三个数 + 三个成长值 ──────────────────────────────
         ⚠️ 三个数是**纯统计**（连续天数 / 参与场次 / 挑战回合），不带 ›、点了不跳：
            这一页对所有人一样，而「连战记录 / 参与场次 / 我的挑战」打开的是
            **看的人自己**的私有列表 —— 在别人的主页上那是错的。
         ⚠️ 每行成长值自己带 border-t，**第一行那条线就是与上面三格的分界** ——
            所以这里不放分隔线、也不放「成长值」小标题（留着会变成线 + 标题 + 线）。 -->
    <view class="bg-white rounded-2.5 p-4 mt-3" wx:if="{{hasProfile}}">
      <view class="flex items-center">
        <view class="flex-1 text-center">
          <view class="flex items-baseline justify-center">
            <text class="text-40rpx font-bold text-ink">{{streakDays}}</text>
            <text class="text-24rpx text-faint ml-1">天</text>
          </view>
          <text class="text-22rpx text-faint block mt-1.5">连续天数</text>
        </view>
        <view class="w-[1rpx] h-[56rpx] bg-line"></view>
        <view class="flex-1 text-center">
          <view class="flex items-baseline justify-center">
            <text class="text-40rpx font-bold text-ink">{{conqueredCount}}</text>
            <text class="text-24rpx text-faint ml-1">场</text>
          </view>
          <text class="text-22rpx text-faint block mt-1.5">参与场次</text>
        </view>
        <view class="w-[1rpx] h-[56rpx] bg-line"></view>
        <view class="flex-1 text-center">
          <view class="flex items-baseline justify-center">
            <text class="text-40rpx font-bold text-ink">{{rounds}}</text>
            <text class="text-24rpx text-faint ml-1">次</text>
          </view>
          <text class="text-22rpx text-faint block mt-1.5">挑战回合</text>
        </view>
      </view>

      <view class="mt-3 pt-3 border-t-[1rpx] border-t-solid border-t-line" wx:for="{{growthRows}}" wx:key="key">
        <view class="flex items-center">
          <text class="text-36rpx">{{item.icon}}</text>
          <text class="text-28rpx text-ink font-medium ml-2 flex-1">{{item.name}}</text>
          <text class="text-36rpx font-bold text-ink">{{item.value}}</text>
        </view>
        <text class="text-22rpx text-faint block mt-1 leading-[1.6]">{{item.blurb}}</text>
      </view>
    </view>
  </block>

</view>
