<!-- ⚠️ padding-top 由 navTop 给（= 导航栏总高 + 12），这里**不要再写 pt-3** ——
     两者相加会多让出 12px。见 lib/nav.ts。 -->
<view class="px-3 pb-[60rpx] bg-page min-h-[100vh] box-border" style="padding-top:{{navTop}}px">

  <!-- ⭐ 启动遮罩：身份解析出结果之前整页盖住（见 components/boot-overlay） -->
  <boot-overlay />

  <!-- ⭐ 统一的自定义导航栏：左侧头像（点头像拉开全局用户面板），中间是品牌名 -->
  <!-- ⚠️ id="nav" 是页面 onPageScroll 找到它的方式（见 lib/nav.ts），三页统一 -->
  <nav-bar id="nav" title="{{brand.name}}" left="avatar" />

  <!-- ══ 块 ⓪：连战提醒 ═══════════════════════════════════════
       ⭐ 放在**最上面**（prd §7.8.1）：断档这件事的价值随时间衰减，
          用户打开的第一眼看不到，就等于没提醒。
       ⚠️ 分级由 lib/streak-nudge.ts 判好（WXML 只画）：
            today / gap1 → 一行轻提示（gap1 带【去补签】）
            gap2         → 卡片（升级一次，但仍不打断）
            gap3         → **不在这里画**：走原生弹窗（最强打断，只配给最后一天）
            restart      → 引导卡（⚠️ 不说失败，见下）
       ⚠️ 即使只断 1 天也不用红色 —— 红是"判错"的颜色（结果页那些红块），
          而这里只是"该回来读一句了"。 -->

  <!-- 今天还没读 / 断 1 天：一行就够 -->
  <view class="flex items-center px-1 mb-2"
        wx:if="{{nudge.level === 'today' || nudge.level === 'gap1'}}">
    <text class="text-24rpx text-warn flex-1 leading-[1.5]">{{nudge.title}} · {{nudge.note}}</text>
    <text class="text-24rpx text-brand ml-2 shrink-0" wx:if="{{nudge.action}}"
          bindtap="onOpenStreak" hover-class="active__opacity-60">{{nudge.action}} ›</text>
  </view>

  <!-- 断 2 天：升级成卡片 -->
  <view class="card p-4 mb-3 border-warn" wx:elif="{{nudge.level === 'gap2'}}">
    <text class="text-28rpx font-medium text-ink">{{nudge.title}}</text>
    <text class="text-24rpx text-body block mt-1.5 leading-[1.6]">{{nudge.note}}</text>
    <view class="mt-3 text-center py-[20rpx] rounded-full bg-brand text-white text-28rpx font-medium"
          bindtap="onOpenStreak" hover-class="active__opacity-60">去补签</view>
  </view>

  <!-- ⚠️⚠️ 断 ≥4 天：**不报失败**。说成"重新开始"，并把"最长的还在"摆出来 ——
       那是在用户已经难过的时候，唯一还能给的东西（prd §7.8）。 -->
  <view class="card p-4 mb-3" wx:elif="{{nudge.level === 'restart'}}">
    <view class="flex items-center">
      <text class="text-32rpx">🌱</text>
      <text class="text-28rpx font-medium text-ink ml-2">{{nudge.title}}</text>
    </view>
    <text class="text-24rpx text-muted block mt-1.5 leading-[1.6]">{{nudge.note}}</text>
  </view>

  <!-- ══ 块 ①：我的状态卡 ═══════════════════════════════════
       ⚠️⚠️ 数据**只来自全局 store**（GET /api/user/me 的结果），本页不为它单独发请求。
          四态见 index.ts 的 data.statusMode / render()：
            · loading  —— 身份还没解析完 ⇒ 骨架
            · data     —— 有用户 ⇒ 三格数字（参与场次 / 挑战回合 / 连战天数）
            · unjoined —— 服务端明确说库里没有我这一行 ⇒ 「未加入」+ 加入
            · unknown  —— 问不到（断网）⇒ 「重新连接」（**绝不画「未加入」**）
       ⚠️ 三格各自可点：参与场次 → 句子粒度；挑战回合 → 提交粒度；连战天数 → 日历。 -->
  <skeleton wx:if="{{statusMode === 'loading'}}" variant="stats" />

  <view wx:else
        class="card py-3.5 mb-3 flex items-center box-border min-h-[144rpx]">
    <block wx:if="{{statusMode === 'data' && stats}}">
      <!-- ⚠️ 第一格是**参与场次**：拿到过分数的去重句子数（一句 = 一个竞技场 = 一场）。 -->
      <view class="flex-1 text-center" bindtap="onOpenParticipations" hover-class="active__opacity-60">
        <view class="flex items-baseline justify-center">
          <text class="text-40rpx font-bold text-ink">{{stats.conqueredCount}}</text>
          <text class="text-24rpx text-faint ml-1">场</text>
        </view>
        <text class="text-22rpx text-faint block mt-1.5">参与场次 ›</text>
      </view>

      <view class="w-[1rpx] h-[56rpx] bg-line"></view>

      <!-- ⚠️ 第二格是**挑战回合**（一共打了几次分）—— 过程量，与「参与场次」分开看。 -->
      <view class="flex-1 text-center" bindtap="onOpenChallenges" hover-class="active__opacity-60">
        <view class="flex items-baseline justify-center">
          <text class="text-40rpx font-bold text-ink">{{stats.challengedRounds}}</text>
          <text class="text-24rpx text-faint ml-1">次</text>
        </view>
        <text class="text-22rpx text-faint block mt-1.5">挑战回合 ›</text>
      </view>

      <view class="w-[1rpx] h-[56rpx] bg-line"></view>

      <view class="flex-1 text-center" bindtap="onOpenStreak" hover-class="active__opacity-60">
        <view class="flex items-baseline justify-center">
          <text class="text-40rpx font-bold text-ink">{{stats.streakDays}}</text>
          <text class="text-24rpx text-faint ml-1">天</text>
        </view>
        <text class="text-22rpx text-faint block mt-1.5">连战天数 ›</text>
      </view>
    </block>

    <!-- ⚠️⚠️ 「问不到」与「未加入」是**两件事**，绝不能画成同一个样子：
         前者是"不知道库里有没有我"，后者是"服务端说没有"。把断网画成「未加入」，
         有账号的老用户会以为账号没了（B31 定下的）。 -->
    <view wx:elif="{{statusMode === 'unknown'}}" class="flex-1 flex items-center justify-center px-2">
      <text class="text-24rpx text-muted">连不上服务器</text>
      <view class="ml-3 shrink-0 px-4 py-[10rpx] rounded-full bg-brand text-white text-24rpx"
            bindtap="onReconnect" hover-class="active__opacity-60">重新连接</view>
    </view>

    <!-- ⭐ 未加入：同一张卡、同一个高度（见下面 onJoin 的说明） -->
    <view wx:else class="flex-1 flex items-center justify-center px-2">
      <text class="text-24rpx text-muted">{{brand.pitch}}</text>
      <view class="ml-3 shrink-0 px-4 py-[10rpx] rounded-full bg-brand text-white text-24rpx"
            bindtap="onJoin" hover-class="active__opacity-60">加入</view>
    </view>
  </view>

  <!-- ══ 块 ②：今日挑战 ═════════════════════════════════════
       ⚠️ 标题是**必须**的：卡片上没有日期，所以"这是今天要读的那句"只能由它说。
       ⚠️ 靠左，与「最新上线」「荣誉榜」同一档字号 + 同一处缩进（三个分组标题是一对）。 -->
  <text class="text-28rpx font-semibold text-ink block px-1 pt-1 pb-2">今日挑战</text>

  <skeleton wx:if="{{todayLoading}}" variant="card" />

  <!-- ⚠️ 错误只在本块**没有内容**时占位；有缓存卡就照常画（刷新失败不该让内容消失） -->
  <view wx:elif="{{todayError && !today}}" class="card p-5">
    <text class="text-28rpx text-bad block leading-[1.6]">{{todayError}}</text>
    <view class="mt-3 text-center py-[22rpx] rounded-full bg-brand text-white text-28rpx"
          bindtap="onRetryToday">重试</view>
  </view>

  <!-- ⭐ 今日推荐 = arena-card 的 featured 形态（主题色 + currentColor 分层）
       ⚠️ 参与状态（已参与描边 / 按钮文案 / 按钮下那行）全部来自 store 的 participation，
          写入方是 lib/participation（GET /api/user/participation/{articleId}）。 -->
  <arena-card wx:elif="{{today}}" mode="featured" entry="{{today}}"
              playing="{{playingArticle === today.articleId}}"
              loading="{{loadingArticle === today.articleId}}"
              bind:open="onOpenDetail" bind:play="onPlayAudio" bind:start="onStart" />

  <!-- ══ 块 ③：最新上线 ══════════════════════════════════════
       ⚠️ 这一段列的是句库里按上线时间（articles.published_at）倒序的最新几句。
       ⚠️ 卡片**不挂药丸、也不挂按钮**（一串同构卡片每张挂按钮会变成按钮墙），
          但**参与状态照拉**（用户 2026-09 口径：所有句子列表都走
          /api/user/participation/{id}）—— list 形态用 joined 画一圈描边，
          不占位、也不跟句子抢眼。 -->
  <view class="pt-6 pb-2 px-1" wx:if="{{latestLoading || latest.length > 0}}">
    <view class="flex items-center">
      <text class="text-28rpx font-semibold text-ink flex-1">最新上线</text>
      <!-- ⭐ 去浏览句库（公开页）：按标签 / 难度翻整个句库，入口就挂在这一段的标题右边 ——
           这里列的是"最新几句"，想看更多自然往这儿点。 -->
      <text class="text-24rpx text-brand" bindtap="onOpenBrowse">浏览句库 ›</text>
    </view>
  </view>

  <skeleton wx:if="{{latestLoading}}" variant="list" rows="3" />

  <view wx:elif="{{latestError && latest.length === 0}}" class="card p-5">
    <text class="text-28rpx text-bad block leading-[1.6]">{{latestError}}</text>
    <view class="mt-3 text-center py-[22rpx] rounded-full bg-brand text-white text-28rpx"
          bindtap="onRetryLatest">重试</view>
  </view>

  <!-- ⭐ 最新上线卡片**整张就是一个入口**，没有按钮：一串同构卡片每张挂按钮会变成按钮墙。 -->
  <arena-card wx:for="{{latest}}" wx:key="articleId" mode="list" entry="{{item}}"
              playing="{{playingArticle === item.articleId}}"
              loading="{{loadingArticle === item.articleId}}"
              bind:open="onOpenDetail" bind:play="onPlayAudio" />

  <!-- ⭐ 这一串之后跟一个**去看全部标签**的入口（用户 2026-09 要求）：
       上面是"最近上了哪几句"，看完自然想知道"句库按主题都有哪些" ——
       标签名录就是那个目录，从它点进具体标签再落到浏览页。
       ⚠️ 只在真有卡片时画（空列表下面挂"看全部标签"会显得这一屏坏了）。 -->
  <view class="card mt-3 py-[26rpx] flex items-center justify-center"
        wx:if="{{latest.length > 0}}"
        bindtap="onOpenTags" hover-class="active__opacity-60">
    <ui-icon class="text-28rpx text-brand shrink-0 mr-1" name="mdi:tag-outline" />
    <text class="text-26rpx text-brand">看全部标签</text>
  </view>

</view>
