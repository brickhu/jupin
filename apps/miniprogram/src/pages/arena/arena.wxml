<!-- ⚠️ padding-top 由 navTop 给（= 导航栏总高 + 12），这里不要再写 pt-3 —— 见 lib/nav.ts -->
<view class="px-3 pb-[60rpx] bg-page min-h-[100vh] box-border" style="padding-top:{{navTop}}px">

  <!-- ⭐ 统一的自定义导航栏。left 不填 = auto：由**页面栈深度**决定画「返回」还是「回首页」 -->
  <nav-bar id="nav" title="朗读竞技场" />

  <!-- ── 加载中 ────────────────────────────────────────────── -->
  <view class="bg-white rounded-2.5 p-5" wx:if="{{loading}}">
    <text class="text-28rpx text-muted">正在加载挑战…</text>
  </view>

  <!-- ── 加载失败 ──────────────────────────────────────────── -->
  <view class="bg-white rounded-2.5 p-5" wx:elif="{{error}}">
    <text class="text-28rpx text-bad block leading-[1.6]">{{error}}</text>
    <view class="mt-3 text-center py-[22rpx] rounded-full bg-brand text-white text-28rpx" bindtap="onRetry">重试</view>
  </view>

  <block wx:else>
    <!-- ── 句子：arena-card 的 featured（不画卡片头、不带 CTA —— 本页 CTA 在底部）── -->
    <arena-card mode="featured" entry="{{sentence}}" />

    <!-- ── 我的战绩 ──────────────────────────────────────── -->
    <view class="bg-white rounded-2.5 p-4 mt-3" wx:if="{{myBest !== null}}">
      <view class="flex">
        <view class="flex-1">
          <text class="text-22rpx text-faint block">我的成绩</text>
          <text class="text-40rpx font-bold text-ink">{{myBestText}}</text>
        </view>
        <view class="flex-1">
          <text class="text-22rpx text-faint block">我的名次</text>
          <text class="text-40rpx font-bold text-ink">{{myRank}}</text>
        </view>
        <view class="flex-1">
          <text class="text-22rpx text-faint block">击败</text>
          <text class="text-40rpx font-bold text-ink">{{myBeatenCount}}</text>
        </view>
      </view>
    </view>

    <!-- ── 排行榜 ────────────────────────────────────────── -->
    <view class="bg-white rounded-2.5 p-4 mt-3">
      <view class="flex items-baseline mb-2">
        <text class="text-24rpx text-faint">排行榜</text>
        <text class="text-22rpx text-faint ml-auto">{{stat}}</text>
      </view>

      <view class="py-[22rpx]" wx:if="{{leaderboard.length === 0}}">
        <text class="text-24rpx text-faint">还没有人上榜 —— 第一个成绩就是第一名</text>
      </view>

      <view class="flex items-center py-[18rpx] border-t-[1rpx] border-t-solid border-t-line"
            wx:for="{{leaderboard}}" wx:key="rank">
        <text class="text-26rpx w-[64rpx] text-faint">{{item.rank}}</text>
        <text class="text-26rpx flex-1 {{item.isMe ? 'text-brand font-semibold' : 'text-body'}}">{{item.nickname}}</text>
        <text class="text-28rpx font-semibold text-ink">{{item.scoreText}}</text>
      </view>

      <!-- ⚠️ 只列前 20。名次靠后的人在这里看不到自己，得明说 —— -->
      <!--    否则会被理解成「我的成绩没了」。我的名次在上面那张卡里。 -->
      <text class="text-22rpx text-faint block mt-2" wx:if="{{participantCount > leaderboard.length}}">只展示前 {{leaderboard.length}} 名 · 共 {{participantCount}} 人参与</text>
    </view>

    <!-- ── 入口 ──────────────────────────────────────────── -->
    <view class="mt-4 text-center py-[30rpx] rounded-full bg-brand text-white text-32rpx font-medium" bindtap="onStart">{{action}}</view>
    <text class="text-22rpx text-faint block text-center mt-2.5" wx:if="{{isToday}}">今天读一句，连续天数就接上了</text>
    <text class="text-22rpx text-faint block text-center mt-2.5" wx:else>这是过去某一天的挑战 —— 重读的成绩会算进那一天</text>
  </block>
</view>
