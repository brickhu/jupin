<!-- ⚠️ padding-top 由 navTop 给（= 导航栏总高 + 12），这里不要再写 pt-3 —— 见 lib/nav.ts -->
<view class="px-3 pb-[60rpx] bg-page min-h-[100vh] box-border" style="padding-top:{{navTop}}px">

  <!-- ⭐ 启动遮罩：身份解析完成前整页盖住（见 components/boot-overlay） -->
  <boot-overlay />
  <!-- ⭐ 统一的自定义导航栏。left 不填 = auto：由页面栈深度决定画「返回」还是「回首页」 -->
  <nav-bar id="nav" title="朗读挑战" />

  <!-- ══ 块 ① 句子卡（**这一页唯一带 CTA 的卡**） ═══════════════════
       ⚠️ 数据来自 GET /api/articles/{id}（**纯句子内容**，全局会话缓存，见 lib/content）。
       ⚠️⚠️ 这一块打不开**不影响**下面几块 —— 参与数据挂在 /api/participations 上，
          与句子这一行在不在无关（用户 2026-09 定的 L1 解耦）。
       ⚠️⚠️ 与首页「今日挑战」那张卡**同一个用法**（arena-card featured）：
          卡片头：播放（左上）+ **收藏 + 收藏数**（右上）；卡里：句子 / 译文 /
          **CTA 按钮** / **我的参与信息**（按钮下方那行）。
          本页只是比 today 多一颗收藏星（showFavorite），所以**不能把 today 的用法原样搬过来**。
       ⚠️ CTA 与参与信息由 arena.ts 的 render() 拼进 entry（action / hint / joined），
          数据来自全局 store（lib/participation）。 -->
  <skeleton wx:if="{{articleLoading}}" variant="card" />

  <view wx:elif="{{articleError}}" class="card p-5">
    <text class="text-28rpx text-bad block leading-[1.6]">{{articleError}}</text>
    <view class="mt-3 text-center py-[22rpx] rounded-full bg-brand text-white text-28rpx"
          bindtap="onRetryArticle">重试</view>
  </view>

  <arena-card wx:elif="{{sentence}}" mode="featured" entry="{{sentence}}"
              playing="{{playingArticle === articleId}}"
              loading="{{loadingArticle === articleId}}"
              showFavorite="{{!favLoading}}" favorite="{{isFavorite}}"
              favoriteCount="{{favoriteCount}}"
              bind:play="onPlayAudio" bind:favorite="onToggleFavorite" bind:start="onStart" />

  <!-- ══ 块 ② 挑战说明（challenge + advice）+ 这个句子的参与概要 ═════
       ⚠️ 顶部两句来自 ArticleDetail（**句子内容**，与块 ① 同一批到）；
          下面几个数是**统计**，两者生命周期不同，所以分两处取数（见下面的注释）。
       ⚠️⚠️ 这些数**不在句子上**（用户 2026-09：统计是聚合派生值，
          挂在内容上会出现"缓存把人数冻住"与"句子一删统计跟着没"）。
          它来自 GET /api/stats/participation —— 见 lib/stats：取数写进全局 store，
          页面从 store 读，靠广播重画。
       ⚠️ 参与人数为 0 时**不写 0**（"0 人参与，最高 0 分"读起来像这题凉了），
          写一句实话：你是第一个。
       ⚠️ **收藏数不在这排**（用户 2026-09 定）：它在句子卡右上角那颗**心旁边**
          （favoriteCount 传给 arena-card），与参与数字分开 ——
          那两个数回答的问题不同（一个"多少人读过"、一个"多少人收了"）。 -->
  <skeleton wx:if="{{statsLoading}}" variant="stats" />

  <view wx:elif="{{statsError}}" class="card p-4 mt-3">
    <text class="text-26rpx text-bad block">{{statsError}}</text>
    <view class="mt-3 text-center py-[18rpx] rounded-full bg-brand text-white text-26rpx"
          bindtap="onRetryStats">重试</view>
  </view>

  <view wx:else class="card p-4 mt-3">
    <!-- ⭐ 这一行原来是「参与概要」四个字 —— 用户 2026-09 要求换成
         **challenge + advice**（挑战宣言 + 朗读建议）。
         它比一个分组标题有用得多：说清"这句难在哪、该怎么读"，
         而下面那三个数回答的是"这个场子现在什么水平"。
         ⚠️ 两者都来自 ArticleDetail（和句子同一批到，见 arena.ts 的 loadArticle），
            都可能为 null（老内容没写）⇒ 各判各的，**不补默认话术**。 -->
    <view class="mb-3" wx:if="{{challenge || advice}}">
      <text wx:if="{{challenge}}" class="text-28rpx text-body leading-[1.6] block">{{challenge}}</text>
      <text wx:if="{{advice}}" class="text-24rpx text-muted leading-[1.6] block mt-1.5">{{advice}}</text>
    </view>

    <view class="flex" wx:if="{{participantCount > 0}}">
      <view class="flex-1">
        <text class="text-22rpx text-faint block">参与人数</text>
        <text class="text-40rpx font-bold text-ink">{{participantCount}}</text>
      </view>
      <view class="flex-1">
        <text class="text-22rpx text-faint block">全场最高分</text>
        <text class="text-40rpx font-bold text-ok">{{topScoreText}}</text>
      </view>
      <view class="flex-1">
        <text class="text-22rpx text-faint block">全场最低分</text>
        <text class="text-40rpx font-bold text-ink">{{lowestScoreText}}</text>
      </view>
    </view>

    <text class="text-24rpx text-faint" wx:else>还没有人参与 —— 第一个成绩就是第一名</text>
  </view>

  <!-- ⚠️ 这里原来有一张单独的「我的参与概要 + CTA」卡（块 ③）——
       用户 2026-09 要求**并进句子卡**（与首页「今日挑战」那张卡的样式一致）：
       CTA 在卡里（entry.action）、我的参与信息在按钮下方那行（entry.hint），
       数据仍来自 GET /api/user/participation/{articleId}（写全局 store）。
       ⇒ 本页不再有第三张卡，别再把它加回来。 -->

  <!-- ══ 块 ③ 排行榜 ═════════════════════════════════════════
       ⚠️ 数据来自 GET /api/participations?articleId=&sort=score&limit=20（公开）。
          每行带服务端算的**全局名次** rank；"是不是我"由端侧拿 userId 比出来
           （公开接口认不出看的人是谁）。 -->
  <skeleton wx:if="{{lbLoading}}" variant="rank" rows="5" />

  <view wx:elif="{{lbError}}" class="card p-4 mt-3">
    <text class="text-24rpx text-faint block mb-2">排行榜</text>
    <text class="text-26rpx text-bad block">{{lbError}}</text>
    <view class="mt-3 text-center py-[18rpx] rounded-full bg-brand text-white text-26rpx"
          bindtap="onRetryLeaderboard">重试</view>
  </view>

  <view wx:else class="card p-4 mt-3">
    <view class="flex items-baseline mb-2">
      <text class="text-24rpx text-faint">排行榜</text>
      <text class="text-22rpx text-faint ml-auto" wx:if="{{lbTotal > 0}}">共 {{lbTotal}} 人参与</text>
    </view>

    <view class="py-[22rpx]" wx:if="{{leaderboard.length === 0}}">
      <text class="text-24rpx text-faint">还没有人上榜 —— 第一个成绩就是第一名</text>
    </view>

    <!-- ⭐ 整行可点：看 TA 在这一句上的参与详情（自己那一行不跳，见 onOpenParticipant） -->
    <view class="flex items-center py-[18rpx] border-t-[1rpx] border-t-solid border-t-line"
          wx:for="{{leaderboard}}" wx:key="rank"
          data-uid="{{item.userId}}" data-pid="{{item.participationId}}" bindtap="onOpenParticipant"
          hover-class="active__opacity-60">
      <text class="text-26rpx w-[64rpx] text-faint">{{item.rank}}</text>
      <!-- ⭐ 头像 + 昵称：fileID 已在 arena.ts 里换过址，这里只管画。
           ⚠️ 没头像 / 换址失败时退回本地占位图（不留空圈，也不塌行高） -->
      <image class="w-[48rpx] h-[48rpx] rounded-full shrink-0 mr-2" src="{{item.avatarSrc || avatarPlaceholder}}" mode="aspectFill" />
      <text class="text-26rpx flex-1 {{item.isMe ? 'text-brand font-semibold' : 'text-body'}}">{{item.nickname}}</text>
      <text class="text-28rpx font-semibold text-ink">{{item.scoreText}}</text>
      <!-- ⭐ 行尾箭头 = "这一行能点"（与卡片/列表同一套提示）。点它看这一行的参与详情。 -->
      <ui-icon class="text-24rpx text-faint ml-2 shrink-0" name="mdi:chevron-right" />
    </view>

    <!-- ⚠️ 只列前 20。名次靠后的人在这里看不到自己，得明说 ——
         否则会被理解成「我的成绩没了」。我的名次在上面那张卡里。 -->
    <text class="text-22rpx text-faint block mt-2" wx:if="{{lbTotal > leaderboard.length}}">只展示前 {{leaderboard.length}} 名 · 共 {{lbTotal}} 人参与</text>
  </view>

  <!-- ══ ⑤ 邀请好友 ═══════════════════════════════════════════
       ⚠️⚠️ 必须是 button[open-type=share]：小程序里**只有**它能让用户主动拉起转发
          （普通 view 的 bindtap 调不起转发面板 —— 见 pages/profile 的同一处说明）。 -->
  <button class="ar-invite mt-4" open-type="share">
    <text class="text-32rpx">邀请好友参与挑战</text>
  </button>
</view>
