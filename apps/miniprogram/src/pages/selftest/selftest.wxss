.page {
  padding: 24rpx 24rpx 60rpx;
  background: #f7f7f8;
  min-height: 100vh;
  box-sizing: border-box;
}

.head { display: flex; flex-direction: column; margin-bottom: 24rpx; }
.title { font-size: 40rpx; font-weight: 600; color: #111; }
.sub { font-size: 24rpx; color: #999; margin-top: 8rpx; }

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.phase { font-size: 32rpx; font-weight: 600; color: #111; }
.hint { font-size: 26rpx; color: #666; margin-top: 12rpx; line-height: 1.6; }

.section-title { font-size: 26rpx; color: #999; display: block; margin-bottom: 16rpx; }

.item { padding: 20rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.item:last-child { border-bottom: none; }
.item-head { display: flex; align-items: baseline; }
.mark { font-size: 30rpx; margin-right: 10rpx; }
.item-id { font-size: 26rpx; font-weight: 600; color: #111; margin-right: 12rpx; }
.item-title { font-size: 26rpx; color: #333; flex: 1; }

.kv { display: flex; margin-top: 10rpx; padding-left: 40rpx; }
.k { font-size: 24rpx; color: #aaa; width: 80rpx; flex-shrink: 0; }
.v { font-size: 24rpx; color: #666; flex: 1; word-break: break-all; }
.v.strong { color: #111; }

.note {
  font-size: 22rpx;
  color: #b08a3e;
  background: #fdf8ee;
  padding: 12rpx 16rpx;
  border-radius: 10rpx;
  margin-top: 12rpx;
  margin-left: 40rpx;
  line-height: 1.5;
}

.btn-primary {
  background: #111;
  color: #fff;
  text-align: center;
  padding: 28rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  margin-bottom: 20rpx;
}
.btn-primary.disabled { background: #bbb; }

.btn-secondary {
  background: #fff;
  color: #333;
  text-align: center;
  padding: 26rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.sweep-line {
  font-size: 24rpx;
  color: #333;
  line-height: 1.9;
  font-family: monospace;
  word-break: break-all;
}

.report {
  font-size: 22rpx;
  color: #444;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
}
