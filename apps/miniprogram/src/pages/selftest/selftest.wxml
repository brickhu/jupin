<view class="page">
  <view class="head">
    <text class="title">真机自检 T1–T6</text>
    <text class="sub">纯端侧测试，不依赖后端 / 云托管 / 讯飞密钥</text>
    <text class="sub">当前环境：{{env}}</text>
  </view>

  <!-- 当前阶段 -->
  <view class="card">
    <view class="phase">{{phase}}</view>
    <view class="hint">{{hint}}</view>
  </view>

  <!-- 结果 -->
  <view class="card" wx:if="{{items.length > 0}}">
    <text class="section-title">结果</text>
    <view class="item" wx:for="{{items}}" wx:key="id">
      <view class="item-head">
        <text class="mark">{{item.pass === true ? '✅' : (item.pass === false ? '❌' : '➖')}}</text>
        <text class="item-id">{{item.id}}</text>
        <text class="item-title">{{item.title}}</text>
      </view>
      <view class="kv"><text class="k">期望</text><text class="v">{{item.expected}}</text></view>
      <view class="kv"><text class="k">实测</text><text class="v strong">{{item.actual}}</text></view>
      <view class="note" wx:if="{{item.note}}">{{item.note}}</view>
    </view>
  </view>

  <!-- 操作 -->
  <view class="btn-primary {{running ? 'disabled' : ''}}" bindtap="onRunAll">
    {{running ? '自检进行中…' : '开始自检（约 20 秒）'}}
  </view>

  <view class="btn-secondary" bindtap="onSweepFrameSize">扫描 frameSize（1/2/4/8 KB）</view>
  <view class="btn-secondary" bindtap="onTestTone">T3 精测：播 1kHz 标准音并录音</view>

  <!-- frameSize 扫描结果：验证它到底有没有被设备采纳 -->
  <view class="card" wx:if="{{sweep.length > 0}}">
    <text class="section-title">frameSize 扫描</text>
    <view class="sweep-line" wx:for="{{sweep}}" wx:key="*this">{{item}}</view>
  </view>
  <view class="btn-secondary" wx:if="{{done}}" bindtap="onCopy">复制报告</view>

  <!-- 原始报告，方便直接看 -->
  <view class="card" wx:if="{{report}}">
    <text class="section-title">报告原文</text>
    <text class="report">{{report}}</text>
  </view>
</view>
