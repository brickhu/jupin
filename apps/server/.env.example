# ---- 运行环境 ----
NODE_ENV=development
PORT=3000

# ---- 数据库 ----
DATABASE_URL=postgres://postgres:dev@localhost:5432/jushuo

# ---- 鉴权 ----
TOKEN_SECRET=change-me-in-production

# ---- 评分引擎 ----
# mock = 本地开发（不烧额度） | xfyun = 真实引擎
ENGINE=mock

# 科大讯飞 ISE（语音评测流式版）
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=

# ---- 内容生产（仅 tools/pipeline 需要）----
FISH_AUDIO_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
