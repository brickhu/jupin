# 本地开发环境配置
# ⚠️ 复制为 .env 后填写真实值；.env 已被 gitignore

NODE_ENV=development
PORT=3000

# 本地 PG（docker compose 起的那个；若改过宿主机端口，这里同步改）
DATABASE_URL=postgres://postgres:dev@localhost:5432/jushuo

TOKEN_SECRET=dev-secret-change-me-at-least-8-chars

# mock = 本地开发（不烧额度） | xfyun = 真实引擎
ENGINE=mock

# 科大讯飞 ISE（语音评测流式版）
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=

# 对象存储：local = 落盘到 .uploads/（本地联调） | wxcloud = 微信云托管对象存储
STORAGE=local
WX_CLOUD_ENV_ID=

# 评完分是否删除音频（隐私策略）
DELETE_AUDIO_AFTER_SCORE=true

# 内容生产流水线专用（tools/pipeline）
FISH_AUDIO_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
