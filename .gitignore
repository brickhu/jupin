# ---- 依赖 ----
node_modules/
.pnpm-store/
.pnpm-home/

# ---- 构建产物 ----
dist/
build/
*.tsbuildinfo
miniprogram_npm/

# ---- 环境变量（⚠️ 绝不可提交）----
.env
.env.*
!.env.example
!.env.*.example

# ---- 小程序私有配置 ----
project.private.config.json
private.key

# ---- 部署临时包 ----
# ⚠️ deploy-cloud.mjs 会在仓库根打一个 .cloudrun_<服务>_<时间戳>.zip 再上传，
#    正常路径下它会自己删；但进程被杀/中断时就会留下 —— 而它接近 100MB，
#    一旦被提交就永远压在历史里（本仓库踩过：GitHub 单文件上限正好是 100MB）。
.cloudrun_*.zip

# ---- 内容流水线中间产物 ----
tools/pipeline/data/drafts/
tools/pipeline/data/out/

# ---- 日志与系统 ----
*.log
npm-debug.log*
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# ---- 编辑器/工具 ----
.trae/
.uploads/

# ---- 旧工程（v1，待清理）----
# 保留在 git 历史中即可

# Docker buildx 配置重定向（沙箱/CI 用）
.buildx/
.docker/
