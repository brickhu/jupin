{
  "name": "jupin",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @jushuo/server dev",
    "dev:mp": "pnpm --filter @jushuo/miniprogram dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check:docs": "node tools/check-docs.mjs",
    "plan:status": "node tools/plan-status.mjs",
    "plan:sync": "node tools/plan-status.mjs --write",
    "check": "pnpm typecheck && pnpm test && pnpm check:docs && pnpm plan:status --strict",
    "dev:docker": "docker compose --profile full up -d --build",
    "dev:docker:logs": "docker compose logs -f api",
    "dev:docker:down": "docker compose --profile full down",
    "dev:docker:reset": "docker compose --profile full down -v && pnpm dev:docker",
    "dev:docker:ps": "docker compose --profile full ps",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @jushuo/server db:generate",
    "db:migrate": "pnpm --filter @jushuo/server db:migrate",
    "seed": "pnpm --filter @jushuo/server seed",
    "seed:arena": "node_modules/.bin/tsx apps/server/src/db/seed-dev-arena.ts",
    "pipeline": "pnpm --filter @jushuo/pipeline start",
    "content:audio": "tsx tools/build-content-audio.ts",
    "dev:unlock": "node tools/dev-unlock.mjs",
    "dev:unlock:status": "node tools/dev-unlock.mjs --status",
    "db:info": "node tools/cloud-db-info.mjs",
    "admin": "pnpm --filter @jushuo/admin start",
    "seed:cloud": "node tools/seed-cloud.mjs",
    "seed:cloud:prod": "node tools/seed-cloud.mjs prod",
    "db:info:prod": "node tools/cloud-db-info.mjs prod",
    "deploy:dev": "node tools/deploy-cloud.mjs dev",
    "deploy:prod": "node tools/deploy-cloud.mjs prod"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@wxcloud/cli": "^2.3.3",
    "drizzle-orm": "^0.38.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
