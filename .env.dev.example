# ============================================================
#  句拼 · 环境变量（**云托管 dev**）
#
#  适用：真机调试 / 预览 / 体验版（config.ts 里 develop 与 trial 都指这里）
#  ⚠️ 键名**不带 _DEV 后缀** —— 文件名本身就是环境标识
#  ⚠️ 这份文件只被「部署 dev」加载，所以本机的 ENGINE=mock 盖不到它
# ============================================================

# 环境 ID（控制台「环境」页可复制）
WXCLOUD_ENV_ID=dev-0go66cfz212d3d83

# MySQL 连接信息。
# ⭐ 内网地址会变！（serverless 实例重建后 IP 会换，服务环境变量不会自动跟着走）
#    查法：pnpm db:info          ← 自动比对并提示不一致
#    填这里即可，pnpm deploy:dev 时会被写进服务环境变量
MYSQL_ADDRESS=10.10.103.8:3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=
MYSQL_DATABASE=jushuo

# 云端显式选真引擎（不写也行：公用 .env 里讯飞凭据齐全时会自动判成 xfyun）
ENGINE=xfyun
STORAGE=wxcloud

# ⚠️ WX_CLOUD_ENV_ID 不用写在这里 —— 服务端要的那个由 deploy 脚本
#    从上面的 WXCLOUD_ENV_ID 自动填进服务环境变量（本地 STORAGE=local 时用不到它）。

# ⚠️ TOKEN_SECRET 不用手填：首次部署时由 deploy 脚本生成并写回本文件。
#    它必须**每个环境各一份** —— 共用的话，dev 泄露就等于 prod 泄露。
# TOKEN_SECRET=
