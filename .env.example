# ============================================================
#  句说 · 本地与部署配置模板
#
#  用法：cp .env.example .env   然后把 <...> 换成真实值
#  ⚠️ .env 已被 gitignore，**绝不要提交**
# ============================================================

# ------------------------------------------------------------
# 一、本地 Docker（模拟器走这条）
# ------------------------------------------------------------
# 宿主机端口。容器内固定是 MySQL:3306 / API:3000
# ⚠️ 本机 3306 / 3000 常被别的项目占用，所以默认挪开
DB_PORT=5544
API_PORT=8899


# ------------------------------------------------------------
# 二、微信云托管：账号级凭据（三个环境共用）
# ------------------------------------------------------------
# 小程序 AppID
WXCLOUD_APPID=wxc0418392e9116a01

# CLI 密钥：控制台 → 设置 → 全局设置 → CLI 密钥 → 生成密钥
# ⚠️ 生成时需要管理员扫码；平台不保存，丢了只能重新生成
# ⚠️ 拿到后先跑一次： ./node_modules/.bin/wxcloud login --appId $WXCLOUD_APPID --privateKey $WXCLOUD_CLI_SECRET
WXCLOUD_CLI_SECRET=


# ------------------------------------------------------------
# 三、dev 环境（真机调试 / 预览 / 体验版 走这条）
# ------------------------------------------------------------
WXCLOUD_ENV_ID=dev-0go66cfz212d3d83

# MySQL 连接信息。
# ⭐ 内网地址会变！（serverless 实例重建后 IP 会换，服务环境变量不会自动跟着走）
#    查法：pnpm db:info          ← 自动比对并提示不一致
#    填这里即可，pnpm deploy:dev 时会被写进服务环境变量
MYSQL_ADDRESS_DEV=10.10.103.14:3306
MYSQL_USERNAME_DEV=root
MYSQL_PASSWORD_DEV=
MYSQL_DATABASE_DEV=jushuo


# ------------------------------------------------------------
# 四、prod 环境（正式版走这条）
# ------------------------------------------------------------
WXCLOUD_ENV_ID_PROD=prod-9gjwc01kcd98d6d1

MYSQL_ADDRESS_PROD=10.10.110.98:3306
MYSQL_USERNAME_PROD=root
MYSQL_PASSWORD_PROD=
MYSQL_DATABASE_PROD=jushuo


# ------------------------------------------------------------
# 五、服务端运行时变量
# ------------------------------------------------------------
# ⚠️ 一般不用在这里填 —— pnpm deploy:dev / deploy:prod 会自动生成并同步到服务环境变量。
#    列在这里只是让你知道有这些开关。
#
# TOKEN_SECRET=<deploy 脚本自动生成 64 位随机串>
# NODE_ENV=production
# PORT=3000
# TZ=UTC
# ENGINE=mock                 # mock | xfyun
# STORAGE=wxcloud             # local | wxcloud
# AUTO_MIGRATE=true           # 容器启动时自动建表
# DELETE_AUDIO_AFTER_SCORE=true


# ------------------------------------------------------------
# 六、⭐ 小程序端构建配置
# ------------------------------------------------------------
# 小程序**没有运行时环境变量**（没有 process.env），值必须在构建时烘进包里。
# 这些 MP_* 由 apps/miniprogram/build.mjs 读走，用 esbuild define 注入 config.ts。
# ⚠️ 源码里不允许出现这些值的字面量 —— 改环境只改这里，不改代码。
# ⚠️ 前四项缺失会**直接让构建失败**（静默连不上比报错难查得多）。

# 模拟器打的本机地址（端口取上面的 API_PORT）
MP_LOCAL_API_URL=http://localhost:8899

# 真机走局域网的逃生通道。⚠️ 机器相关，留空即禁用
# 查法：ipconfig getifaddr en0
MP_LAN_API_URL=

# 云托管环境 ID（控制台「环境」页可复制）
MP_DEV_ENV_ID=dev-0go66cfz212d3d83
MP_PROD_ENV_ID=prod-9gjwc01kcd98d6d1

# 云托管服务名（必须与控制台「服务列表」里的名字完全一致）
MP_CLOUD_SERVICE=jushuo


# ------------------------------------------------------------
# 七、真实评分引擎（讯飞 ISE）—— 现在还没接，留空即可
# ------------------------------------------------------------
# 接入时：控制台 → 服务设置 → 环境变量 里加这三个，或写进本文件让 deploy 带上
# XFYUN_APP_ID=
# XFYUN_API_KEY=
# XFYUN_API_SECRET=


# ------------------------------------------------------------
# 八、内容生产流水线（tools/pipeline）
# ------------------------------------------------------------
# FISH_AUDIO_KEY=
# LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com/v1
