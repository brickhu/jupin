# ============================================================
#  句拼 · 环境变量（**公用**）
#
#  ⚠️ 环境变量一共四份，全部在仓库根目录，**绝不散在子包里**：
#
#     .env          公用（本文件）—— 账号级凭据 / 小程序构建注入 / 本机端口
#     .env.local    本地          —— DevTools（模拟器）+ 本机 docker + 内容流水线
#     .env.dev      云托管 dev
#     .env.prod     云托管 prod
#
#  优先级（后者覆盖前者，**真实环境变量永远最高**）：
#
#     进程环境变量  >  .env.<mode>  >  .env
#
#  由 tools/env.mjs 统一加载（部署工具 / 小程序构建 / 服务端都走它）。
#  ⚠️ 同名键**只在对应的那份文件里出现一次** —— 分层规则就是为了这个：
#     比如 ENGINE / STORAGE，本机想 mock、云上要真引擎，
#     以前散在两个文件里，结果「本机的 mock 把云端的自动判据盖住了」。
#
#  用法：cp .env.example .env && cp .env.local.example .env.local
#        （dev / prod 同理，见各自模板）
#  ⚠️ 除 *.example 外的 .env* 都已被 gitignore，**绝不要提交**
# ============================================================


# ------------------------------------------------------------
# 一、本机端口（docker compose 与 .env.local 的 DATABASE_URL 都要对得上）
# ------------------------------------------------------------
# 容器内固定是 MySQL:3306 / API:3000；这里只是**宿主机**映射出来的端口
# ⚠️ 本机 3306 / 3000 常被别的项目占用，所以默认挪开
DB_PORT=5544
API_PORT=8899


# ------------------------------------------------------------
# 二、微信云托管：账号级凭据（dev / prod 共用，因为同一个小程序）
# ------------------------------------------------------------
WXCLOUD_APPID=wxc0418392e9116a01

# CLI 密钥：控制台 → 设置 → 全局设置 → CLI 密钥 → 生成密钥
# ⚠️ 生成时需要管理员扫码；平台不保存，丢了只能重新生成
# ⚠️ 拿到后先跑一次： ./node_modules/.bin/wxcloud login --appId $WXCLOUD_APPID --privateKey $WXCLOUD_CLI_SECRET
WXCLOUD_CLI_SECRET=

# ⭐ 小程序 AppID + AppSecret —— **服务端**用（不是 CLI 密钥，两者别混）
# 用途两条：
#   ① 对象存储：换 access_token 调 /tcb/uploadfile、/tcb/batchdownloadfile、/tcb/batchdeletefile
#      —— 官方明写这三个「不支持云调用」，所以**不依赖开放接口服务（旁加载）**
#   ② 登录降级路径的 code2session（见 apps/server/src/routes/auth.ts）
# ⚠️⚠️ 绝不能写进下面那组 MP_* —— 那组会被构建期烘进小程序包
WX_APPID=wxc0418392e9116a01
WX_SECRET=


# ------------------------------------------------------------
# 三、真实评分引擎（讯飞 ISE）—— 两个环境共用同一个讯飞应用
# ------------------------------------------------------------
# 配齐三个键，deploy 会自动把 ENGINE 判成 xfyun；只在 .env.<mode> 里显式写
# ENGINE=mock 才会回退成假结果。
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=


# ------------------------------------------------------------
# 四、⭐ 小程序端构建配置
# ------------------------------------------------------------
# 小程序**没有运行时环境变量**（没有 process.env），值必须在构建时烘进包里。
# 这些 MP_* 由 apps/miniprogram/build.mjs 读走，用 esbuild define 注入 config.ts。
# ⚠️ 三种模式的值要**一起**烘进去（config.ts 运行时按平台/版本选），
#    所以它们属于"公用"，不属于任何单一份 .env.<mode>。
# ⚠️ 源码里不允许出现这些值的字面量 —— 改环境只改这里，不改代码。
# ⚠️ 前四项缺失会**直接让构建失败**（静默连不上比报错难查得多）。

# 模拟器打的本机地址（端口取上面的 API_PORT）
MP_LOCAL_API_URL=http://localhost:8899

# 云托管环境 ID（控制台「环境」页可复制）
MP_DEV_ENV_ID=dev-0go66cfz212d3d83
MP_PROD_ENV_ID=prod-9gjwc01kcd98d6d1

# 云托管服务名（必须与控制台「服务列表」里的名字完全一致）
MP_CLOUD_SERVICE=jupin


# ------------------------------------------------------------
# 五、内容生产流水线（tools/pipeline）—— 密钥放 .env.local
# ------------------------------------------------------------
# FISH_AUDIO_KEY / LLM_API_KEY / LLM_BASE_URL / LLM_MODEL / LLM_TEMPERATURE
