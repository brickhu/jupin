# ============================================================
#  句拼 · 环境变量（**本地**）
#
#  适用：开发者工具（模拟器）→ 本机 docker 的 API
#       本机直接跑服务端（pnpm dev）
#       内容生产流水线（tools/pipeline）
#
#  分层规则见 .env.example：进程环境变量 > .env.local > .env
# ============================================================

NODE_ENV=development
PORT=3000

# ⚠️ 宿主机端口必须与公用 .env 里的 DB_PORT 一致（这里是 5544）
#    容器内那份不在这里 —— docker-compose 会注入 …@db:3306，
#    而真实环境变量优先级最高，正好盖住这一行
DATABASE_URL=mysql://jushuo:dev@127.0.0.1:5544/jushuo

# 本地会话密钥（与 dev/prod **各用各的**，不要共用）
TOKEN_SECRET=dev-secret-change-me-at-least-8-chars

# 本地联调账号名 —— 决定伪 openid（dev_local / dev_xxx）。
# ⚠️ 必须是**稳定**的：小程序每次启动都会重新登录一次，
#    如果 openid 跟着 wx.login 的 code 变，每次重载都会变成"一个没起过名字的新用户"，
#    症状是"我明明加入过了，怎么又让我加入"。
# ⭐ 想开第二个测试账号：改这里（或给 /api/auth/login 传 as）后重启 api。
# DEV_OPENID=local

# mock = 本地不烧讯飞额度 | xfyun = 真实引擎
ENGINE=mock

# local = 落盘到 .uploads/ | wxcloud = 微信云托管对象存储
STORAGE=local

# 评完分是否删除音频（隐私策略）
DELETE_AUDIO_AFTER_SCORE=true

# 真机走局域网的逃生通道（云环境全挂时手动切）
# ⚠️ 机器相关，留空即禁用；查法：ipconfig getifaddr en0
MP_LAN_API_URL=

# ---- 内容生产流水线（tools/pipeline）----
LLM_API_KEY=
# ⚠️ 写域名即可，**不要**带 /v1（代码自己会拼 /v1/chat/completions；
#    带上了也能跑，但那是容错，不是推荐写法）
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=
LLM_TEMPERATURE=

# ---- 标准音 TTS（fish-audio）----
# ⚠️ 本机直连 api.fish.audio 会超时，必须走代理（代码会把 socks5:// 纠正成 socks5h://）
FISH_API_KEY=
FISH_PROXY_URL=socks5://127.0.0.1:1081
# 音色**不在这里配**：默认音色是 tools/pipeline/src/lib/fishaudio.ts 里的 DEFAULT_VOICE_ID，
# 换音色 = 全库标准音的音色一起换，必须是可评审、可回滚的一处改动。
# 只有临时试音色才用 FISH_VOICE_ID 覆盖。

# ---- 本地内容管理台（tools/admin，pnpm admin → 127.0.0.1:4983）----
# 自建管理员账号。⚠️ ADMIN_PASSWORD 留空时，服务第一次启动会**随机生成一个**
# 并写回这份 .env.local，同时把它打在控制台（不猜、不默认）。
ADMIN_USER=admin
# ADMIN_PASSWORD=
